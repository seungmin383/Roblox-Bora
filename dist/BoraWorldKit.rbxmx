<roblox version="4">
  <Item class="Model" referent="0">
    <Properties>
      <string name="Name">BoraWorldKit</string>
      <BinaryString name="AttributesSerialize">AQAAAAcAAABWZXJzaW9uAgUAAAAwLjEuMA==</BinaryString>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">Definitions</string>
        <string name="Source"><![CDATA[-- 설정과 모습의 기준을 한곳에 모아 여러 맵에서 같은 에셋을 재사용합니다.
local Definitions = {}

Definitions.SchemaVersion = 1
Definitions.Seasons = { "Spring", "Summer", "Autumn", "Winter" }
Definitions.BranchCounts = { Sparse = 3, Normal = 5, Dense = 7 }
Definitions.Species = {
	Ginkgo = {
		Label = "은행나무",
		Bark = { 110, 91, 68 },
		Spring = { 156, 190, 80 }, Summer = { 101, 151, 63 },
		Autumn = { 239, 192, 48 }, Winter = { 156, 143, 121 },
	},
	Maple = {
		Label = "단풍나무",
		Bark = { 105, 82, 66 },
		Spring = { 137, 176, 84 }, Summer = { 72, 131, 68 },
		Autumn = { 194, 70, 43 }, Winter = { 153, 138, 122 },
	},
	Pine = {
		Label = "소나무",
		Bark = { 105, 73, 52 },
		Spring = { 58, 113, 79 }, Summer = { 43, 94, 66 },
		Autumn = { 51, 100, 66 }, Winter = { 46, 85, 66 },
	},
}

return Definitions
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">TreeFactory</string>
        <string name="Source"><![CDATA[-- 엔진 객체 생성 부분을 함수로 묶어 Studio와 파일 빌드에서 같은 코드를 실행합니다.
return function(api, definitions)
	local Instance, Vector3, CFrame, Color3, Enum = api.Instance, api.Vector3, api.CFrame, api.Color3, api.Enum
	local Factory = {}
	local function number(value, default, minimum, maximum, label)
		if value == nil then value = default end
		assert(type(value) == "number" and value == value and value >= minimum and value <= maximum,
			label .. " must be between " .. minimum .. " and " .. maximum)
		return value
	end

	local function color(rgb)
		return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	end

	local function part(parent, name, size, frame, tint, shape, collidable)
		local item = Instance.new("Part")
		item.Name, item.Size, item.CFrame = name, size, frame
		item.Shape = shape or Enum.PartType.Block
		item.Material = Enum.Material.SmoothPlastic
		item.Color, item.Anchored = tint, true
		item.CanCollide, item.CanTouch, item.CanQuery = collidable, false, collidable
		item.TopSurface, item.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		item.Parent = parent
		return item
	end

	local function beam(parent, name, a, b, diameter, tint, collidable)
		local delta = b - a
		-- 수직 줄기는 기본 위쪽 벡터와 평행하므로 보조 축을 바꿔 회전을 안정화합니다.
		local up = if math.abs(delta.Unit.Y) > 0.98 then Vector3.xAxis else Vector3.yAxis
		-- Cylinder의 길이축은 X이므로 X축을 가지 방향에 맞춥니다.
		return part(parent, name, Vector3.new(delta.Magnitude, diameter, diameter),
			CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0),
			tint, Enum.PartType.Cylinder, collidable)
	end

	function Factory.validate(config)
		local species = config.Species or "Ginkgo"
		assert(definitions.Species[species], "Unknown tree species: " .. tostring(species))
		local branchPreset = config.BranchPreset or "Normal"
		assert(definitions.BranchCounts[branchPreset], "Unknown branch preset")
		local season = config.Season or "Summer"
		assert(table.find(definitions.Seasons, season), "Unknown season")
		local seasonMode = config.SeasonMode or "World"
		assert(seasonMode == "World" or seasonMode == "Fixed", "SeasonMode must be World or Fixed")
		local seed = number(config.Seed, 42, 0, 2147483646, "Seed")
		assert(seed % 1 == 0, "Seed must be an integer")
		return {
			Species = species, Height = number(config.Height, 14, 4, 40, "Height"),
			TrunkDiameter = number(config.TrunkDiameter, 0.7, 0.2, 3, "TrunkDiameter"),
			CanopyWidth = number(config.CanopyWidth, 9, 2, 24, "CanopyWidth"),
			BranchPreset = branchPreset, Seed = seed, Season = season, SeasonMode = seasonMode,
			ObjectId = config.ObjectId,
		}
	end

	function Factory.applySeason(model, season)
		assert(table.find(definitions.Seasons, season), "Unknown season")
		local species = model:GetAttribute("Species")
		local style = definitions.Species[species]
		assert(style, "Model is not a supported tree")
		local leaves = model:FindFirstChild("Foliage")
		assert(leaves, "Tree has no Foliage folder")
		for _, leaf in leaves:GetChildren() do
			if leaf:IsA("BasePart") then
				leaf.Color = color(style[season])
				leaf.Transparency = if season == "Winter" and species ~= "Pine" then 1 else 0
				leaf.CastShadow = leaf.Transparency == 0
			end
		end
		model:SetAttribute("Season", season)
	end

	function Factory.create(config, transform)
		local settings = Factory.validate(config)
		local style = definitions.Species[settings.Species]
		local model = Instance.new("Model")
		model.Name = settings.Species .. "Tree"
		model:SetAttribute("AssetKind", "Tree")
		model:SetAttribute("AssetId", "Bora.Tree." .. settings.Species)
		model:SetAttribute("SchemaVersion", definitions.SchemaVersion)
		for key, value in settings do model:SetAttribute(key, value) end
		local frame = transform or CFrame.new()
		local h, d, w = settings.Height, settings.TrunkDiameter, settings.CanopyWidth
		local foliage = Instance.new("Folder")
		foliage.Name, foliage.Parent = "Foliage", model
		beam(model, "Trunk", frame.Position, (frame * CFrame.new(0, h * 0.76, 0)).Position,
			d, color(style.Bark), true)
		-- 편집·재생성을 위한 기준점은 줄기 중심이 아니라 지면 접점입니다.
		model.WorldPivot = frame
		local randomState = settings.Seed + 1
		local function random()
			randomState = (randomState * 48271) % 2147483647
			return randomState / 2147483647
		end
		local branchCount = definitions.BranchCounts[settings.BranchPreset]
		for index = 1, branchCount do
			local angle = index * math.pi * 2 / branchCount + random() * 0.3
			local radius = w * (0.23 + random() * 0.08)
			local branchStart = (frame * CFrame.new(0, h * (0.38 + index / branchCount * 0.15), 0)).Position
			local tip = Vector3.new(math.cos(angle) * radius, h * (0.67 + random() * 0.12), math.sin(angle) * radius)
			beam(model, "Branch" .. index, branchStart, (frame * CFrame.new(tip)).Position,
				math.max(0.12, d * 0.36), color(style.Bark), false)
			if settings.Species ~= "Pine" then
				local shapeSize = if settings.Species == "Ginkgo"
					then Vector3.new(w * 0.52, h * 0.28, w * 0.44)
					else Vector3.new(w * 0.57, h * 0.32, w * 0.57)
				part(foliage, "Crown" .. index, shapeSize, frame * CFrame.new(tip),
					color(style[settings.Season]), Enum.PartType.Ball, false)
			end
		end
		if settings.Species == "Pine" then
			-- 외부 메시 없이 구분 가능한 층형 수관을 만드는 초기 원형입니다.
			for tier = 1, 4 do
				local width = w * (1 - (tier - 1) * 0.19)
				part(foliage, "NeedleTier" .. tier, Vector3.new(width, h * 0.23, width),
					frame * CFrame.new(0, h * (0.48 + (tier - 1) * 0.125), 0),
					color(style[settings.Season]), Enum.PartType.Ball, false)
			end
		else
			part(foliage, "CrownTop", Vector3.new(w * 0.68, h * 0.30, w * 0.68),
				frame * CFrame.new(0, h * 0.85, 0), color(style[settings.Season]), Enum.PartType.Ball, false)
		end
		Factory.applySeason(model, settings.Season)
		return model
	end

	-- 기존 모델을 건드리기 전에 새 모델을 완성해서 수동 편집 유실을 줄입니다.
	function Factory.rebuild(model, overrides)
		assert(model:GetAttribute("AssetKind") == "Tree", "Select a generated tree")
		local config = model:GetAttributes()
		for key, value in overrides or {} do config[key] = value end
		local replacement = Factory.create(config, model:GetPivot())
		replacement.Name, replacement.Parent = model.Name, model.Parent
		model:Destroy()
		return replacement
	end

	return Factory
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">RoadFactory</string>
        <string name="Source"><![CDATA[-- 끝점은 도로 표면 중앙입니다. 위치와 높이 차이를 함께 써서 평지·경사를 만듭니다.
return function(api)
	local Instance, Vector3, CFrame, Color3, Enum = api.Instance, api.Vector3, api.CFrame, api.Color3, api.Enum
	local Factory = {}
	local function numeric(value, default, minimum, maximum, label)
		if value == nil then value = default end
		assert(type(value) == "number" and value == value and value >= minimum and value <= maximum,
			label .. " must be between " .. minimum .. " and " .. maximum)
		return value
	end
	local function nodeId(point)
		return string.format("%.2f,%.2f,%.2f", point.X, point.Y, point.Z)
	end
	local function slab(parent, name, size, frame, color, material, collidable)
		local part = Instance.new("Part")
		part.Name, part.Size, part.CFrame, part.Color = name, size, frame, color
		part.Material, part.Anchored = material, true
		part.CanCollide, part.CanTouch, part.CanQuery = collidable, false, collidable
		part.TopSurface, part.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Parent = parent
		return part
	end

	function Factory.create(config)
		local startPoint, endPoint = config.Start, config.End
		assert(typeof(startPoint) == "Vector3" and typeof(endPoint) == "Vector3", "Start and End must be Vector3")
		local delta = endPoint - startPoint
		local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
		assert(horizontal == horizontal and horizontal >= 2 and horizontal <= 512, "Road horizontal length must be 2–512 studs")
		local grade = math.abs(delta.Y) / horizontal
		assert(grade <= 0.25, "Road grade must be at most 25%; move the end point farther away")
		local width = numeric(config.Width, 14, 4, 40, "Width")
		local sidewalk = numeric(config.SidewalkWidth, 3, 0, 8, "SidewalkWidth")
		local thickness, curbHeight = 0.6, 0.35
		local frame = CFrame.lookAt((startPoint + endPoint) / 2, endPoint)
		local length = delta.Magnitude
		local model = Instance.new("Model")
		model.Name = if grade > 0.001 then "SlopeRoad" else "StraightRoad"
		model:SetAttribute("AssetKind", "Road")
		model:SetAttribute("AssetId", "Bora.Road.Straight")
		model:SetAttribute("SchemaVersion", 1)
		model:SetAttribute("ObjectId", config.ObjectId)
		model:SetAttribute("StartPosition", startPoint)
		model:SetAttribute("EndPosition", endPoint)
		model:SetAttribute("StartNodeId", nodeId(startPoint))
		model:SetAttribute("EndNodeId", nodeId(endPoint))
		model:SetAttribute("Width", width)
		model:SetAttribute("SidewalkWidth", sidewalk)
		model:SetAttribute("GradePercent", grade * 100)
		model.WorldPivot = frame
		slab(model, "Asphalt", Vector3.new(width, thickness, length), frame * CFrame.new(0, -thickness / 2, 0),
			Color3.fromRGB(58, 61, 66), Enum.Material.Asphalt, true)
		if sidewalk > 0 then
			for _, side in { -1, 1 } do
				slab(model, if side == -1 then "SidewalkLeft" else "SidewalkRight",
					Vector3.new(sidewalk, thickness + curbHeight, length),
					frame * CFrame.new(side * (width + sidewalk) / 2, (curbHeight - thickness) / 2, 0),
					Color3.fromRGB(174, 174, 167), Enum.Material.Concrete, true)
			end
		end
		for _, offset in { -0.16, 0.16 } do
			slab(model, "CenterLine", Vector3.new(0.1, 0.025, length), frame * CFrame.new(offset, 0.018, 0),
				Color3.fromRGB(231, 186, 64), Enum.Material.SmoothPlastic, false)
		end
		return model
	end

	return Factory
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="4">
      <Properties>
        <string name="Name">PluginMain</string>
        <string name="Source"><![CDATA[-- Studio 편집 도구입니다. 플레이 중 실행하는 게임 스크립트가 아닙니다.
if not plugin then return end

local RunService = game:GetService("RunService")
local Selection = game:GetService("Selection")
local History = game:GetService("ChangeHistoryService")
local HttpService = game:GetService("HttpService")
local definitions = require(script.Parent.Definitions)
local api = { Instance = Instance, Vector3 = Vector3, CFrame = CFrame, Color3 = Color3, Enum = Enum }
local trees = require(script.Parent.TreeFactory)(api, definitions)
local roads = require(script.Parent.RoadFactory)(api)

local toolbar = plugin:CreateToolbar("보라동 제작")
local openButton = toolbar:CreateButton("BoraWorldKit", "나무와 직선·경사 도로 배치", "", "에셋 배치")
local widget = plugin:CreateDockWidgetPluginGui("BoraWorldKit_v1", DockWidgetPluginGuiInfo.new(
	Enum.InitialDockState.Right, false, false, 350, 660, 300, 380))
widget.Title = "보라동 에셋 도구 · v0.1"
local scroll = Instance.new("ScrollingFrame")
scroll.Size, scroll.BackgroundColor3 = UDim2.fromScale(1, 1), Color3.fromRGB(35, 38, 44)
scroll.BorderSizePixel, scroll.ScrollBarThickness = 0, 6
scroll.AutomaticCanvasSize, scroll.CanvasSize = Enum.AutomaticSize.Y, UDim2.new()
scroll.Parent = widget
local padding = Instance.new("UIPadding")
padding.PaddingTop, padding.PaddingBottom = UDim.new(0, 12), UDim.new(0, 12)
padding.PaddingLeft, padding.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
padding.Parent = scroll
local layout = Instance.new("UIListLayout")
layout.Padding, layout.SortOrder, layout.Parent = UDim.new(0, 6), Enum.SortOrder.LayoutOrder, scroll
local order = 0
local function base(class, height)
	local gui = Instance.new(class)
	order += 1
	gui.LayoutOrder, gui.Size = order, UDim2.new(1, -8, 0, height)
	gui.BackgroundColor3, gui.BorderSizePixel = Color3.fromRGB(54, 59, 68), 0
	gui.Font, gui.TextSize, gui.TextColor3 = Enum.Font.SourceSans, 16, Color3.fromRGB(235, 239, 245)
	gui.Parent = scroll
	return gui
end
local function label(text, height)
	local gui = base("TextLabel", height or 24)
	gui.Text, gui.BackgroundTransparency = text, 1
	gui.TextXAlignment, gui.TextWrapped = Enum.TextXAlignment.Left, true
	return gui
end
local function field(title, value)
	label(title)
	local gui = base("TextBox", 30)
	gui.Text, gui.ClearTextOnFocus = tostring(value), false
	return gui
end
local function button(text, callback)
	local gui = base("TextButton", 32)
	gui.Text = text
	gui.MouseButton1Click:Connect(callback)
	return gui
end

label("나무 · 수종과 크기 설정")
local speciesIndex, seasonIndex, branchIndex = 1, 2, 2
local seasonMode = "World"
local speciesKeys, branchKeys = { "Ginkgo", "Maple", "Pine" }, { "Sparse", "Normal", "Dense" }
local speciesButton, seasonButton, branchButton
speciesButton = button("수종: 은행나무", function()
	speciesIndex = speciesIndex % #speciesKeys + 1
	speciesButton.Text = "수종: " .. definitions.Species[speciesKeys[speciesIndex]].Label
end)
local height = field("높이 (4–40 studs)", 14)
local diameter = field("줄기 지름 (0.2–3)", 0.7)
local canopy = field("수관 너비 (2–24)", 9)
local seed = field("변형 시드 (정수)", 42)
local branchLabels = { "적음", "보통", "많음" }
branchButton = button("가지: 보통", function()
	branchIndex = branchIndex % #branchKeys + 1
	branchButton.Text = "가지: " .. branchLabels[branchIndex]
end)
local seasonLabels = { "봄", "여름", "가을", "겨울" }
seasonButton = button("계절: 여름", function()
	seasonIndex = seasonIndex % #definitions.Seasons + 1
	seasonButton.Text = "계절: " .. seasonLabels[seasonIndex]
end)
local seasonModeButton
seasonModeButton = button("나무 계절: 월드 따라감", function()
	seasonMode = if seasonMode == "World" then "Fixed" else "World"
	seasonModeButton.Text = if seasonMode == "World" then "나무 계절: 월드 따라감" else "나무 계절: 선택한 계절 고정"
end)
local status = label("설정 후 배치 버튼을 누르세요.", 54)
local mouse = plugin:GetMouse()
local mode, startPoint, preview, activeTreeConfig, activeRoadConfig

local function cancel()
	mode, startPoint, activeTreeConfig, activeRoadConfig = nil, nil, nil, nil
	if preview then preview:Destroy(); preview = nil end
	mouse.TargetFilter = nil
	plugin:Deactivate()
end
local function treeConfig()
	-- 숫자가 아닌 입력을 조용히 기본값으로 바꾸지 않고 사용자에게 알려줍니다.
	local function read(box, name)
		local value = tonumber(box.Text)
		assert(value, name .. "에 숫자를 입력하세요.")
		return value
	end
	return trees.validate({
		Species = speciesKeys[speciesIndex], Height = read(height, "높이"),
		TrunkDiameter = read(diameter, "줄기 지름"), CanopyWidth = read(canopy, "수관 너비"),
		Seed = read(seed, "시드"), BranchPreset = branchKeys[branchIndex],
		Season = if seasonMode == "World" then (workspace:GetAttribute("WorldSeason") or definitions.Seasons[seasonIndex])
			else definitions.Seasons[seasonIndex], SeasonMode = seasonMode,
	})
end
local function record(title, action)
	if RunService:IsRunning() then status.Text = "Play를 중지한 뒤 편집하세요."; return end
	local id = History:TryBeginRecording("BoraWorldKit_" .. title, title)
	if not id then status.Text = "다른 편집 기록이 끝난 뒤 다시 시도하세요."; return end
	local ok, result = pcall(action)
	History:FinishRecording(id, if ok then Enum.FinishRecordingOperation.Commit else Enum.FinishRecordingOperation.Cancel)
	status.Text = if ok then title .. " 완료 · Ctrl+Z로 되돌릴 수 있어요." else tostring(result)
	return ok, result
end
local function folder()
	local root = workspace:FindFirstChild("BoraPlacedAssets")
	if root then assert(root:IsA("Folder"), "BoraPlacedAssets 이름은 Folder에만 사용하세요."); return root end
	root = Instance.new("Folder")
	root.Name, root.Parent = "BoraPlacedAssets", workspace
	return root
end
local function previewTree()
	preview = trees.create(activeTreeConfig)
	preview.Name = "BoraPlacementPreview"
	preview:SetAttribute("AssetKind", "Preview")
	for _, item in preview:GetDescendants() do
		if item:IsA("BasePart") then
			item.CanCollide, item.CanTouch, item.CanQuery, item.CastShadow = false, false, false, false
			if item.Transparency < 1 then item.Transparency = 0.6 end
		end
	end
	mouse.TargetFilter = preview
end

button("나무 배치 · 지면 클릭", function()
	cancel()
	if RunService:IsRunning() then status.Text = "Play를 중지한 뒤 편집하세요."; return end
	local ok, config = pcall(treeConfig)
	if not ok then status.Text = tostring(config); return end
	mode, activeTreeConfig = "Tree", config
	previewTree()
	plugin:Activate(true)
	status.Text = "지면을 클릭하면 배치합니다. 취소 버튼으로 종료하세요."
end)
button("선택한 나무를 현재 설정으로 재생성", function()
	cancel()
	local selected = Selection:Get()
	if #selected ~= 1 or not selected[1]:IsA("Model") or selected[1]:GetAttribute("AssetKind") ~= "Tree" then
		status.Text = "Explorer에서 나무 Model 하나를 선택하세요."; return
	end
	local ok, config = pcall(treeConfig)
	if not ok then status.Text = tostring(config); return end
	config.ObjectId = selected[1]:GetAttribute("ObjectId")
	record("나무 재생성", function()
		local replacement = trees.rebuild(selected[1], config)
		Selection:Set({ replacement })
	end)
end)
button("월드 나무에 선택한 계절 적용", function()
	cancel()
	record("계절 변경", function()
		local season = definitions.Seasons[seasonIndex]
		workspace:SetAttribute("WorldSeason", season)
		for _, item in workspace:GetDescendants() do
			if item:IsA("Model") and item:GetAttribute("AssetKind") == "Tree"
				and item:GetAttribute("SeasonMode") == "World" then trees.applySeason(item, season) end
		end
	end)
end)

label("도로 · 표면 시작점과 끝점 연결", 30)
local roadWidth = field("차도 폭 (4–40)", 14)
local sidewalkWidth = field("양쪽 보도 폭 (각 0–8)", 3)
local roadRise = field("끝점 추가 높이 (studs, 경사 최대 25%)", 0)
button("도로 배치 · 시작점 → 끝점 클릭", function()
	cancel()
	if RunService:IsRunning() then status.Text = "Play를 중지한 뒤 편집하세요."; return end
	local width, sidewalk, rise = tonumber(roadWidth.Text), tonumber(sidewalkWidth.Text), tonumber(roadRise.Text)
	if not width or not sidewalk or not rise or width < 4 or width > 40 or sidewalk < 0 or sidewalk > 8
		or rise ~= rise or math.abs(rise) > 128 then
		status.Text = "폭과 높이에 허용 범위의 숫자를 입력하세요."; return
	end
	activeRoadConfig, mode = { Width = width, SidewalkWidth = sidewalk, Rise = rise }, "Road"
	plugin:Activate(true)
	status.Text = "도로 표면의 시작점을 클릭하세요. 끝점 높이는 클릭한 높이 + 추가 높이입니다."
end)
button("배치 취소", function() cancel(); status.Text = "배치를 종료했습니다." end)
label("원형 에셋 v0.1 · 직선/경사만 지원\n지형 자동 수정과 곡선·교차로 연결은 다음 단계입니다.", 60)

mouse.Move:Connect(function()
	if mode == "Tree" and preview then
		if mouse.Target then preview.Parent = workspace; preview:PivotTo(CFrame.new(mouse.Hit.Position))
		else preview.Parent = nil end
	end
end)
mouse.Button1Down:Connect(function()
	if not mode or not mouse.Target then return end
	local position = mouse.Hit.Position
	if mode == "Tree" then
		record("나무 배치", function()
			local config = table.clone(activeTreeConfig)
			config.ObjectId = HttpService:GenerateGUID(false)
			if config.SeasonMode == "World" then config.Season = workspace:GetAttribute("WorldSeason") or config.Season end
			local model = trees.create(config, CFrame.new(position))
			model.Parent = folder()
		end)
	elseif not startPoint then
		-- 평평한 지면과 도로 표면이 겹쳐 깜빡이지 않도록 약간 띄웁니다.
		startPoint = position + Vector3.new(0, 0.05, 0)
		status.Text = "시작점 저장 완료. 도로 끝점을 클릭하세요."
	else
		local ok = record("도로 배치", function()
			local model = roads.create({ Start = startPoint,
				End = position + Vector3.new(0, activeRoadConfig.Rise + 0.05, 0),
				Width = activeRoadConfig.Width, SidewalkWidth = activeRoadConfig.SidewalkWidth,
				ObjectId = HttpService:GenerateGUID(false) })
			model.Parent = folder()
			Selection:Set({ model })
		end)
		if ok then startPoint = nil end
	end
end)
openButton.Click:Connect(function() widget.Enabled = not widget.Enabled end)
widget:GetPropertyChangedSignal("Enabled"):Connect(function()
	openButton:SetActive(widget.Enabled)
	if not widget.Enabled then cancel() end
end)
plugin.Deactivation:Connect(function()
	mode, startPoint = nil, nil
	if preview then preview:Destroy(); preview = nil end
	mouse.TargetFilter = nil
end)
plugin.Unloading:Connect(cancel)
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>