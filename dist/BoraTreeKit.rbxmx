    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name"><![CDATA[TreeAssetCatalog]]></string>
        <string name="Source"><![CDATA[local Vector3=Vector3
local prefix="rbxasset://BoraTreeKitV3/"
return {
Wood={Mesh=prefix.."ConnectedWood.mesh",Texture=prefix.."ConnectedBark.png",Bounds=Vector3.new(0.643164039,0.999999940,0.584760070)},
Leaf={Texture=prefix.."GinkgoCluster.png"},
ProceduralBark=prefix.."ProceduralBark.png",
WoodHeight=18.08158405125141,
CrownAnchors={
Vector3.new(0.277560209,0.500133679,-0.093239513),
Vector3.new(0.267999935,0.499185679,0.015700166),
Vector3.new(0.273223349,0.546036785,-0.174735263),
Vector3.new(-0.283576402,0.554332445,-0.064064607),
Vector3.new(-0.187001220,0.553384445,-0.127591289),
Vector3.new(-0.323257619,0.600235551,0.000128564),
Vector3.new(0.170201211,0.608531263,0.292210789),
Vector3.new(0.061061475,0.607583263,0.276263882),
Vector3.new(0.239701390,0.654434317,0.273416876),
Vector3.new(0.091279365,0.662730029,-0.266948756),
Vector3.new(0.155516862,0.661782029,-0.175661441),
Vector3.new(0.029022677,0.708633136,-0.293509978),
