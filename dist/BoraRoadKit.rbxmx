<roblox version="4">
  <Item class="Model" referent="0">
    <Properties>
      <string name="Name"><![CDATA[BoraRoadKit]]></string>
      <BinaryString name="AttributesSerialize">AQAAAAcAAABWZXJzaW9uAgUAAAAwLjcuMA==</BinaryString>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name"><![CDATA[RoadPath]]></string>
        <string name="Source"><![CDATA[-- Persistent centerlines are shared by hand tracing and a future image importer.
return function(Vector3)
	local Path={StudsPerMeter=1/.28}
	Path.Defaults={Width=7,Lanes=2,Sidewalk=1.5,Curve=75,Lift=.05}
	Path.Limits={Width={2.5,24},Lanes={1,6},Sidewalk={0,5},Curve={0,100},Lift={0,2}}
	-- Odd totals allocate the extra lane toward the road's end control point.
	-- Incoming lanes are numbered from the center divider to the driver's right.
	function Path.lanes(config,sign)
		local total=config.Lanes
		local width=config.Width*Path.StudsPerMeter
		local laneWidth=width/total
		local split=math.floor(total/2)
		local divider=-width*.5+split*laneWidth
		local count=if total==1 then 1 elseif sign==1 then split else total-split
		local centers={}
		for i=1,count do centers[i]=if total==1 then 0 else sign*divider-(i-.5)*laneWidth end
		return {Count=count,Width=laneWidth,Centers=centers,Divider=if total==1 then 0 else divider,Split=split}
	end
	function Path.normalize(input)
		local out={}
		for key,default in Path.Defaults do
			local value=if input[key]==nil then default else input[key]
			local bounds=Path.Limits[key]
			assert(type(value)=='number' and value==value and value>=bounds[1] and value<=bounds[2],key..' 범위를 확인하세요.')
			if key=='Lanes' then assert(value%1==0,'차선 수는 정수여야 합니다.') end
			out[key]=value
		end
		assert(out.Width/out.Lanes>=1.8,'차선 하나의 폭을 1.8m 이상으로 설정하세요.')
		return out
	end
	function Path.validatePoints(points)
		assert(#points>=2 and #points<=128,'도로 점은 2~128개가 필요합니다.')
		for i,p in points do
			assert(typeof(p)=='Vector3' and p.X==p.X and p.Y==p.Y and p.Z==p.Z and p.Magnitude<1e6,'잘못된 도로 점입니다.')
			if i>1 then
				local d=p-points[i-1]
				assert(Vector3.new(d.X,0,d.Z).Magnitude>=1,'점 사이 간격을 1 stud 이상 띄우세요.')
			end
		end
	end
	function Path.sample(points,input)
		Path.validatePoints(points)
		local config=Path.normalize(input)
		local samples={}; local total=0
		for i=1,#points-1 do
			local a,b=points[i],points[i+1]
			local before,after=points[math.max(1,i-1)],points[math.min(#points,i+2)]
			local straight=b-a
			local smooth=config.Curve/100
			local t0=straight:Lerp((b-before)*.5,smooth)
			local t1=straight:Lerp((after-a)*.5,smooth)
			local count=math.max(1,math.ceil(straight.Magnitude/10))
			assert(#samples+count<=1024,'도로 한 개가 너무 깁니다. 나눠서 그리세요.')
			for j=if i==1 then 0 else 1,count do
				local t=j/count; local t2,t3=t*t,t*t*t
				local p=a*(2*t3-3*t2+1)+t0*(t3-2*t2+t)+b*(-2*t3+3*t2)+t1*(t3-t2)
				p=Vector3.new(p.X,math.clamp(p.Y,math.min(a.Y,b.Y),math.max(a.Y,b.Y)),p.Z)
				if #samples>0 then
					local delta=p-samples[#samples].P
					local horizontal=Vector3.new(delta.X,0,delta.Z).Magnitude
					assert(horizontal>.001,'도로가 되접힙니다. 점을 더 멀리 배치하세요.')
					assert(math.abs(delta.Y)/horizontal<=.25,'경사가 25%를 넘습니다. 높이를 낮추거나 점 간격을 늘리세요.')
					total+=delta.Magnitude
				end
				table.insert(samples,{P=p,Distance=total,Segment=i})
			end
		end
		for i,s in samples do
			local incoming=s.P-samples[math.max(1,i-1)].P
			local outgoing=samples[math.min(#samples,i+1)].P-s.P
			incoming=Vector3.new(incoming.X,0,incoming.Z)
			outgoing=Vector3.new(outgoing.X,0,outgoing.Z)
			if incoming.Magnitude<.001 then incoming=outgoing end
			if outgoing.Magnitude<.001 then outgoing=incoming end
			incoming,outgoing=incoming.Unit,outgoing.Unit
			assert(incoming:Dot(outgoing)>-.6,'너무 급한 코너입니다. 중간 점으로 완만하게 연결하세요.')
			local tangent=(incoming+outgoing).Unit
			s.Side=Vector3.new(-tangent.Z,0,tangent.X)
			s.Miter=math.min(2,1/math.max(.5,tangent:Dot(incoming)))
		end
		return {Samples=samples,Length=total,Config=config}
	end
	function Path.offset(sample,offset)
		return sample.P+sample.Side*(offset*sample.Miter)
	end
	function Path.at(data,distance)
		distance=math.clamp(distance,0,data.Length)
		for i=1,#data.Samples-1 do
			local a,b=data.Samples[i],data.Samples[i+1]
			if distance<=b.Distance+.00001 then
				local t=math.clamp((distance-a.Distance)/(b.Distance-a.Distance),0,1)
				return {P=a.P:Lerp(b.P,t),Side=a.Side:Lerp(b.Side,t).Unit,Miter=a.Miter+(b.Miter-a.Miter)*t,Distance=distance}
			end
		end
		return data.Samples[#data.Samples]
	end
	function Path.project(data,p)
		local best,at,position=math.huge,0,data.Samples[1].P
		for i=1,#data.Samples-1 do
			local a,b=data.Samples[i],data.Samples[i+1]
			local d=Vector3.new(b.P.X-a.P.X,0,b.P.Z-a.P.Z)
			local t=math.clamp(Vector3.new(p.X-a.P.X,0,p.Z-a.P.Z):Dot(d)/d:Dot(d),0,1)
			local q=a.P:Lerp(b.P,t)
			local distance=Vector3.new(p.X-q.X,0,p.Z-q.Z).Magnitude
			if distance<best then best,at,position=distance,a.Distance+(b.Distance-a.Distance)*t,q end
		end
		return position,at,best
	end
	-- Intersections of sampled centerlines. A grid avoids scanning every pair
	-- of short segments; arc-distance deduplication handles shared sample vertices.
	function Path.crossings(a,b)
		local function bounds(data)
			if data.Bounds then return data.Bounds end
			local box={math.huge,math.huge,-math.huge,-math.huge}
			for _,s in data.Samples do box[1]=math.min(box[1],s.P.X); box[2]=math.min(box[2],s.P.Z); box[3]=math.max(box[3],s.P.X); box[4]=math.max(box[4],s.P.Z) end
			data.Bounds=box; return box
		end
		local aa,bb=bounds(a),bounds(b)
		if aa[1]>bb[3] or aa[3]<bb[1] or aa[2]>bb[4] or aa[4]<bb[2] then return {} end
		local function cells(p,q,visit)
			for x=math.floor(math.min(p.X,q.X)/64),math.floor(math.max(p.X,q.X)/64) do
				for z=math.floor(math.min(p.Z,q.Z)/64),math.floor(math.max(p.Z,q.Z)/64) do visit(x..':'..z) end
			end
		end
		if not b.Grid then
			b.Grid={}
			for j=1,#b.Samples-1 do cells(b.Samples[j].P,b.Samples[j+1].P,function(key)
				if not b.Grid[key] then b.Grid[key]={} end; table.insert(b.Grid[key],j)
			end) end
		end
		local result={}
		local function cross(u,v) return u.X*v.Z-u.Z*v.X end
		for i=1,#a.Samples-1 do
			local p,q=a.Samples[i],a.Samples[i+1]; local u=q.P-p.P; local seen={}
			cells(p.P,q.P,function(key)
				for _,j in b.Grid[key] or {} do if not seen[j] then
					seen[j]=true
					local r,s=b.Samples[j],b.Samples[j+1]; local v=s.P-r.P
					local denominator=cross(u,v)
					if math.abs(denominator)>.00001 then
						local t,k=cross(r.P-p.P,v)/denominator,cross(r.P-p.P,u)/denominator
						if t>=-.00001 and t<=1.00001 and k>=-.00001 and k<=1.00001 then
							t,k=math.clamp(t,0,1),math.clamp(k,0,1)
							local da,db=p.Distance+(q.Distance-p.Distance)*t,r.Distance+(s.Distance-r.Distance)*k
							local pa,pb=p.P:Lerp(q.P,t),r.P:Lerp(s.P,k)
							local height=pa.Y-pb.Y+(a.Config.Lift-b.Config.Lift)*Path.StudsPerMeter
							if da>1 and da<a.Length-1 and db>1 and db<b.Length-1 and math.abs(height)<=.35 then
								local duplicate=false
								for _,hit in result do if math.abs(hit.A-da)<.05 and math.abs(hit.B-db)<.05 then duplicate=true; break end end
								if not duplicate then table.insert(result,{A=da,B=db,P=pa}) end
							end
						end
					end
				end end
			end)
		end
		return result
	end
	-- Split at exact cut boundaries so asphalt, curbs and lane lines meet portals.
	function Path.segments(data,cuts)
		local segments={}
		for i=1,#data.Samples-1 do
			local a,b=data.Samples[i],data.Samples[i+1]
			local cursor=a.Distance
			for _,cut in cuts or {} do
				if cut[2]>cursor and cut[1]<b.Distance then
					if cut[1]>cursor+.0001 then table.insert(segments,{Path.at(data,cursor),Path.at(data,cut[1])}) end
					cursor=math.max(cursor,cut[2])
				end
			end
			if cursor<b.Distance-.0001 then table.insert(segments,{Path.at(data,cursor),b}) end
		end
		return segments
	end
	function Path.closest(points,point)
		local best,index=math.huge,1
		for i=1,#points-1 do
			local a,b=points[i],points[i+1]
			local t=math.clamp((point-a):Dot(b-a)/(b-a):Dot(b-a),0,1)
			local distance=(point-a:Lerp(b,t)).Magnitude
			if distance<best then best,index=distance,i end
		end
		return index,best
	end
	return Path
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name"><![CDATA[RoadNetworkFactory]]></string>
        <string name="Source"><![CDATA[return function(api,Path,Traffic)
	local Instance,Vector3,CFrame,Color3,Enum=api.Instance,api.Vector3,api.CFrame,api.Color3,api.Enum
	local Factory={}
	local function part(parent,class,name,size,frame,color,material,preview)
		local p=Instance.new(class)
		p.Name,p.Size,p.CFrame,p.Color,p.Material=name,size,frame,color,material
		p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,not preview,false,not preview
		p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
		if preview then p.Transparency=.4; p.Color=Color3.fromRGB(70,190,171) end
		p.Parent=parent
		return p
	end
	local function triangle(parent,a,b,c,thickness,color,material,preview)
		local ab,ac,bc=b-a,c-a,c-b
		local abd,acd,bcd=ab:Dot(ab),ac:Dot(ac),bc:Dot(bc)
		if abd>acd and abd>bcd then c,a=a,c elseif acd>abd and acd>bcd then a,b=b,a end
		ab,ac,bc=b-a,c-a,c-b
		local normal=ac:Cross(ab)
		assert(normal.Magnitude>1e-7,'도로 표면이 겹칩니다. 코너를 완만하게 바꾸세요.')
		if normal.Y<0 then b,c=c,b; ab,ac,bc=b-a,c-a,c-b; normal=ac:Cross(ab) end
		local right=normal.Unit
		local up=bc:Cross(right).Unit
		local back=bc.Unit
		local height=math.abs(ab:Dot(up))
		for _,piece in {{(a+b)*.5,right,up,back,math.abs(ab:Dot(back))},{(a+c)*.5,-right,up,-back,math.abs(ac:Dot(back))}} do
			if piece[5]>.001 and height>.001 then
				part(parent,'WedgePart','Surface',Vector3.new(thickness,height,piece[5]),
					CFrame.fromMatrix(piece[1]-right*thickness*.5,piece[2],piece[3],piece[4]),color,material,preview)
			end
		end
	end
	local function strip(parent,a,b,left,right,height,thickness,color,material,preview)
		local lift=Vector3.new(0,height,0)
		local p,q,r,s=Path.offset(a,left)+lift,Path.offset(a,right)+lift,Path.offset(b,right)+lift,Path.offset(b,left)+lift
		triangle(parent,p,q,r,thickness,color,material,preview)
		triangle(parent,p,r,s,thickness,color,material,preview)
	end
	function Factory.isRoad(model)
		return model and model:IsA('Model') and model:GetAttribute('AssetKind')=='BoraRoadPath'
	end
	function Factory.points(model)
		assert(Factory.isRoad(model),'도로를 선택하세요.')
		local folder=assert(model:FindFirstChild('Nodes'),'도로 점이 없습니다.')
		local nodes=folder:GetChildren()
		table.sort(nodes,function(a,b) return a:GetAttribute('Index')<b:GetAttribute('Index') end)
		local points={}; for _,node in nodes do table.insert(points,node.Value) end
		return points
	end
	function Factory.config(model)
		local values={}; for key in Path.Defaults do values[key]=model:GetAttribute(key) end
		return Path.normalize(values)
	end
	local function stage(points,input,preview,cuts,markingCuts)
		local data=Path.sample(points,input)
		local config=data.Config
		local geometry=Instance.new('Folder'); geometry.Name='Geometry'
		local nodes=Instance.new('Folder'); nodes.Name='Nodes'
		local ok,err=pcall(function()
			for i,p in points do
				local node=Instance.new('Vector3Value'); node.Name=string.format('Point%03d',i)
				node.Value,node.Parent=p,nodes; node:SetAttribute('Index',i)
			end
			local asphalt=Instance.new('Folder'); asphalt.Name,asphalt.Parent='Asphalt',geometry
			local sidewalks=Instance.new('Folder'); sidewalks.Name,sidewalks.Parent='Sidewalks',geometry
			local markings=Instance.new('Folder'); markings.Name,markings.Parent='Markings',geometry
			local width,walk,lift=config.Width*Path.StudsPerMeter,config.Sidewalk*Path.StudsPerMeter,config.Lift*Path.StudsPerMeter
			for _,segment in Path.segments(data,cuts) do
				local a,b=segment[1],segment[2]
				strip(asphalt,a,b,-width*.5,width*.5,lift,.6,Color3.fromRGB(57,60,65),Enum.Material.Asphalt,preview)
				if walk>0 then
					for _,side in {-1,1} do
						strip(sidewalks,a,b,side*width*.5,side*(width*.5+walk),lift+.12*Path.StudsPerMeter,.7,Color3.fromRGB(170,172,166),Enum.Material.Concrete,preview)
					end
				end
			end
			local allCuts={}
			for _,set in {cuts or {},markingCuts or {}} do for _,cut in set do table.insert(allCuts,{cut[1],cut[2]}) end end
			table.sort(allCuts,function(a,b) return a[1]<b[1] end)
			local merged={}
			for _,cut in allCuts do
				local last=merged[#merged]
				if last and cut[1]<=last[2] then last[2]=math.max(last[2],cut[2]) else table.insert(merged,cut) end
			end
			if not preview then
				for _,segment in Path.segments(data,merged) do
					local a,b=segment[1],segment[2]
					for lane=1,config.Lanes-1 do
						local isCenter=lane==math.floor(config.Lanes/2)
						if isCenter or math.floor((a.Distance+b.Distance)*.5/14)%2==0 then
							local offset=-width*.5+width*lane/config.Lanes
							local p,q=Path.offset(a,offset),Path.offset(b,offset)
							local delta=q-p
							local mark=part(markings,'Part',if isCenter then 'CenterLine' else 'LaneLine',Vector3.new(.12*Path.StudsPerMeter,.025,delta.Magnitude+.025),
								CFrame.lookAt((p+q)*.5+Vector3.new(0,lift+.025,0),q+Vector3.new(0,lift+.025,0)),
								if isCenter then Color3.fromRGB(239,189,60) else Color3.fromRGB(236,237,224),Enum.Material.SmoothPlastic,false)
							mark.CanCollide,mark.CanQuery=false,false
						end
					end
				end
			end
		end)
		if not ok then geometry:Destroy(); nodes:Destroy(); error(err) end
		return geometry,nodes,data
	end
	function Factory.prepare(points,config,cuts,markingCuts)
		local geometry,nodes,data=stage(points,config,false,cuts,markingCuts)
		return {Geometry=geometry,Nodes=nodes,Data=data,PointCount=#points}
	end
	function Factory.commit(model,prepared)
		assert(Factory.isRoad(model),'도로를 선택하세요.')
		local geometry,nodes,data=prepared.Geometry,prepared.Nodes,prepared.Data
		for _,name in {'Geometry','Nodes'} do
			local old=model:FindFirstChild(name)
			if old then old.Name='Previous'..name; if api.Retire then api.Retire(old) else old:Destroy() end end
		end
		geometry.Parent,nodes.Parent=model,model
		for key,value in data.Config do model:SetAttribute(key,value) end
		model:SetAttribute('LengthMeters',data.Length/Path.StudsPerMeter)
		model:SetAttribute('NodeCount',prepared.PointCount)
		model:SetAttribute('RoadSchemaVersion',1)
		return model
	end
	function Factory.rebuild(model,points,config)
		return Factory.commit(model,Factory.prepare(points,config))
	end
	function Factory.junction(plan)
		local model=Instance.new('Model'); model.Name='TJunction'
		model:SetAttribute('AssetKind','BoraRoadJunction')
		local asphalt=Instance.new('Folder'); asphalt.Name,asphalt.Parent='Asphalt',model
		local walks=Instance.new('Folder'); walks.Name,walks.Parent='Sidewalks',model
		local ok,err=pcall(function()
			for i,p in plan.Perimeter do
				local q=plan.Perimeter[i%#plan.Perimeter+1]
				if (p-plan.Center):Cross(q-plan.Center).Magnitude>.00001 then
					triangle(asphalt,plan.Center,p,q,.6,Color3.fromRGB(57,60,65),Enum.Material.Asphalt,false)
				end
			end
			local lift=Vector3.yAxis*(.12*Path.StudsPerMeter)
			for _,band in plan.Bands do
				local a,b,c,d=band[1]+lift,band[2]+lift,band[3]+lift,band[4]+lift
				if (b-a):Cross(c-a).Magnitude>.00001 then triangle(walks,a,b,c,.7,Color3.fromRGB(170,172,166),Enum.Material.Concrete,false) end
				if (c-a):Cross(d-a).Magnitude>.00001 then triangle(walks,a,c,d,.7,Color3.fromRGB(170,172,166),Enum.Material.Concrete,false) end
			end
			if plan.Traffic then
				local marks=Instance.new('Folder'); marks.Name,marks.Parent='Markings',model
				for _,mark in plan.Traffic.Markings do
					local group=Instance.new('Folder'); group.Name,group.Parent=mark.Kind,marks; group:SetAttribute('Arm',mark.Arm)
					if mark.Lane then group:SetAttribute('Lane',mark.Lane); group:SetAttribute('Directions',mark.Mask) end
					local p=mark.Corners
					triangle(group,p[1],p[2],p[3],.025,Color3.fromRGB(241,241,228),Enum.Material.SmoothPlastic,false)
					if p[4] then triangle(group,p[1],p[3],p[4],.025,Color3.fromRGB(241,241,228),Enum.Material.SmoothPlastic,false) end
					for _,piece in group:GetChildren() do piece.CanCollide,piece.CanQuery=false,false end
				end
				if Traffic then Traffic.buildSignals(model,plan) end
			end
		end)
		if not ok then model:Destroy(); error(err) end
		return model
	end
	function Factory.create(points,config,id)
		local model=Instance.new('Model'); model.Name=utf8.char(0xB3C4,0xB85C)
		model:SetAttribute('AssetKind','BoraRoadPath'); model:SetAttribute('ObjectId',id)
		local ok,err=pcall(Factory.rebuild,model,points,config)
		if not ok then model:Destroy(); error(err) end
		return model
	end
	function Factory.preview(points,config)
		local geometry,nodes=stage(points,config,true)
		nodes:Destroy(); return geometry
	end
	return Factory
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name"><![CDATA[RoadJunctions]]></string>
        <string name="Source"><![CDATA[-- Geometry planning only. Persistent host references are managed by RoadNetwork.
return function(Vector3,Path)
	local J={}
	local function flat(v) return Vector3.new(v.X,0,v.Z) end
	local function cross(a,b) return a.X*b.Z-a.Z*b.X end
	local function side(d) return Vector3.new(-d.Z,0,d.X) end
	local function tangent(s) return Vector3.new(s.Side.Z,0,-s.Side.X) end
	local function intersect(a,u,b,v)
		local denominator=cross(u,v)
		if math.abs(denominator)<.00001 then return nil end
		local t=cross(b-a,v)/denominator
		local k=cross(b-a,u)/denominator
		return a+u*t,t,k
	end
	local function bezier(a,b,c,t) return a*(1-t)^2+b*(2*t*(1-t))+c*t*t end
	-- Each through road supplies two arms; an attached endpoint supplies one.
	function J.planApproaches(approaches)
		local first=approaches[1]
		local hub=Path.at(first.Data,first.At*first.Data.Length)
		local center=hub.P+Vector3.yAxis*(first.Data.Config.Lift*Path.StudsPerMeter)
		local arms,cuts={},{}
		local radius=math.huge
		for index,approach in approaches do
			assert(approach.End==nil or approach.End=='Start' or approach.End=='End','Invalid junction endpoint')
			local data=approach.Data
			local distance=if approach.End=='Start' then 0 elseif approach.End=='End' then data.Length else approach.At*data.Length
			local p=Path.at(data,distance)
			local half=data.Config.Width*Path.StudsPerMeter*.5
			radius=math.min(radius,half*.5)
			cuts[index]={distance,distance}
			for _,sign in (if approach.End=='Start' then {1} elseif approach.End=='End' then {-1} else {1,-1}) do
				table.insert(arms,{Direction=tangent(p)*sign,Half=half,Walk=data.Config.Sidewalk*Path.StudsPerMeter,Data=data,Sign=sign,Anchor=distance,Approach=index})
			end
		end
		assert(#arms==3 or #arms==4,'교차로에는 세 방향 또는 네 방향만 연결할 수 있습니다.')
		for _,arm in arms do arm.Angle=math.atan2(arm.Direction.Z,arm.Direction.X); arm.Trim=radius+2 end
		table.sort(arms,function(a,b) return a.Angle<b.Angle end)
		for i,a in arms do
			local b=arms[i%#arms+1]
			local gap=(b.Angle-a.Angle)%(math.pi*2)
			assert(gap>=math.acos(.72) and gap<=math.pi+.01,'교차로 진입 각도는 약 45~135도로 만드세요.')
			a.Back=gap>math.pi-.01
			if not a.Back then
				local _,u,v=intersect(center+side(a.Direction)*a.Half,a.Direction,center-side(b.Direction)*b.Half,b.Direction)
				assert(u and u>=0 and v>=0,'교차로 모서리를 구성할 수 없습니다. 폭 또는 진입 각도를 조절하세요.')
				a.Trim=math.max(a.Trim,u+radius+2); b.Trim=math.max(b.Trim,v+radius+2)
			end
		end
		for _,arm in arms do
			local endDistance=arm.Anchor+arm.Sign*arm.Trim
			assert(endDistance>1 and endDistance<arm.Data.Length-1,'교차로가 도로 끝에 너무 가깝습니다. 도로를 더 길게 그리세요.')
			local s=Path.at(arm.Data,endDistance)
			local p=s.P+Vector3.yAxis*(arm.Data.Config.Lift*Path.StudsPerMeter)
			local left=s.Side*(arm.Sign*s.Miter)
			arm.Left,arm.Right=p+left*arm.Half,p-left*arm.Half
			arm.OuterLeft,arm.OuterRight=p+left*(arm.Half+arm.Walk),p-left*(arm.Half+arm.Walk)
			arm.PortalDirection=tangent(s)*arm.Sign
			local cut=cuts[arm.Approach]
			cut[1],cut[2]=math.min(cut[1],endDistance),math.max(cut[2],endDistance)
		end
		local perimeter,bands={},{}
		for i,a in arms do
			local b=arms[i%#arms+1]
			table.insert(perimeter,a.Right); table.insert(perimeter,a.Left)
			local control,outerControl
			if not a.Back then
				control=intersect(a.Left,a.PortalDirection,b.Right,b.PortalDirection)
				outerControl=intersect(a.OuterLeft,a.PortalDirection,b.OuterRight,b.PortalDirection)
				assert(control and outerControl and flat(control-center).Magnitude<math.max(a.Trim,b.Trim)*3,'교차로 근처의 곡선을 더 완만하게 만드세요.')
				control=Vector3.new(control.X,(a.Left.Y+b.Right.Y)*.5,control.Z)
				outerControl=Vector3.new(outerControl.X,(a.OuterLeft.Y+b.OuterRight.Y)*.5,outerControl.Z)
			end
			local count=if a.Back then 1 else 10
			local lastInner,lastOuter=a.Left,a.OuterLeft
			for k=1,count do
				local t=k/count
				local inner=if a.Back then a.Left:Lerp(b.Right,t) else bezier(a.Left,control,b.Right,t)
				local outer=if a.Back then a.OuterLeft:Lerp(b.OuterRight,t) else bezier(a.OuterLeft,outerControl,b.OuterRight,t)
				if k<count then table.insert(perimeter,inner) end
				if a.Walk>0 or b.Walk>0 then table.insert(bands,{lastInner,lastOuter,outer,inner}) end
				lastInner,lastOuter=inner,outer
			end
		end
		for i,p in perimeter do
			assert(cross(flat(p-center),flat(perimeter[i%#perimeter+1]-center))>=-.001,'교차로 코너가 겹칩니다. 진입부를 곧게 펴세요.')
		end
		return {Center=center,Perimeter=perimeter,Bands=bands,Cuts=cuts,Arms=arms,Approaches=approaches}
	end
	function J.plan(host,branch,at,endpoint)
		local plan=J.planApproaches({{Data=host,At=at},{Data=branch,End=endpoint}})
		plan.HostCut,plan.BranchCut=plan.Cuts[1],plan.Cuts[2]
		return plan
	end
	function J.checkCuts(cuts)
		table.sort(cuts,function(a,b) return a[1]<b[1] end)
		for i=2,#cuts do assert(cuts[i][1]>=cuts[i-1][2]+1,'교차로가 너무 가깝습니다. 연결점을 더 멀리 띄우세요.') end
	end
	return J
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name"><![CDATA[RoadNetwork]]></string>
        <string name="Source"><![CDATA[return function(api,Path,Roads,Junctions,Traffic,LaneDirections)
	local Instance,Vector3=api.Instance,api.Vector3
	local Network={}
	local function retire(item)
		if api.Retire then api.Retire(item) else item:Destroy() end
	end
	function Network.links(road)
		local links={}; local folder=road:FindFirstChild('JunctionLinks')
		if folder then
			for _,ref in folder:GetChildren() do
				if ref:IsA('ObjectValue') and Roads.isRoad(ref.Value) and ref.Value.Parent then
					table.insert(links,{Host=ref.Value,At=ref:GetAttribute('At'),End=ref.Name})
				end
			end
		end
		return links
	end
	function Network.snap(folder,p,current,limit)
		local best,target,link=limit or 8,p,nil
		if not folder then return target end
		-- Reuse the host of a saved hub when adding the opposite T arm. A
		-- branch-to-branch attachment would otherwise produce overlapping patches.
		local junctions=folder:FindFirstChild('Junctions')
		if junctions then for _,junction in junctions:GetChildren() do
			local ref=junction:FindFirstChild('Host'); local at=junction:GetAttribute('At')
			local host=if ref and ref:IsA('ObjectValue') then ref.Value else nil
			if Roads.isRoad(host) and host.Parent==folder and host~=current and type(at)=='number' then
				local data=Path.sample(Roads.points(host),Roads.config(host))
				local q=Path.at(data,data.Length*at).P
				local delta=Vector3.new(p.X-q.X,0,p.Z-q.Z).Magnitude
				if delta<best and math.abs(q.Y-p.Y)<3 then best,target,link=delta,q,{Host=host,At=at} end
			end
		end end
		if link then return target,link end
		for _,road in folder:GetChildren() do if Roads.isRoad(road) and road~=current then
			local data=Path.sample(Roads.points(road),Roads.config(road))
			local q,distance,delta=Path.project(data,p)
			if distance<8 or distance>data.Length-8 then
				distance=if distance<8 then 0 else data.Length
				q=Path.at(data,distance).P
				delta=Vector3.new(p.X-q.X,0,p.Z-q.Z).Magnitude
			end
			if delta<best and math.abs(q.Y-p.Y)<3 then
				best,target=delta,q
				link=if distance>1 and distance<data.Length-1 then {Host=road,At=distance/data.Length} else nil
			end
		end end
		return target,link
	end
	function Network.attachEnds(folder,points,current)
		local list,links=table.clone(points),{}
		for _,index in {1,#points} do
			local p,link=Network.snap(folder,points[index],current)
			list[index]=p
			if link then link.End=if index==1 then 'Start' else 'End'; table.insert(links,link) end
		end
		return list,links
	end
	local function samePoints(a,b)
		if #a~=#b then return false end
		for i,p in a do if (p-b[i]).Magnitude>.00001 then return false end end
		return true
	end
	-- Plan/stage everything before touching saved objects, then commit in the
	-- caller's single ChangeHistory recording. A rejected junction changes nothing.
	function Network.apply(folder,changed,points,config,links,trafficInput,laneInput)
		local previous=folder:FindFirstChild('Junctions')
		assert(not previous or previous:GetAttribute('AssetKind')=='BoraRoadJunctions','Junctions 이름의 사용자 폴더가 있습니다.')
		local states,order={},{ }
		for _,road in folder:GetChildren() do if Roads.isRoad(road) then
			local state={Road=road,Original=Roads.points(road),Config=Roads.config(road),Links=Network.links(road),Cuts={},MarkingCuts={},ReservedCuts={}}
			state.Points=table.clone(state.Original); states[road]=state; table.insert(order,state)
		end end
		assert(#order<=256,'도로가 256개를 넘습니다. 구역 분리 지원이 필요합니다.')
		if changed then
			local state=assert(states[changed],'도로가 도로 폴더 밖에 있습니다.')
			state.Points,state.Config=table.clone(points),Path.normalize(config)
			if links then state.Links=links end
		end
		local function resolve(state)
			if state.Data then return end
			assert(not state.Resolving,'순환 연결은 아직 지원하지 않습니다. 한쪽 연결을 분리하세요.')
			state.Resolving=true
			local occupied={}
			for _,link in state.Links do
				assert(link.End=='Start' or link.End=='End','잘못된 연결 끝점입니다.')
				assert(not occupied[link.End],'한 끝점에는 연결 하나만 가능합니다.'); occupied[link.End]=true
				assert(type(link.At)=='number' and link.At>0 and link.At<1,'잘못된 교차로 위치입니다.')
				local host=assert(states[link.Host],'연결 대상 도로가 없습니다.')
				resolve(host)
				local p=Path.at(host.Data,host.Data.Length*link.At).P
				state.Points[if link.End=='Start' then 1 else #state.Points]=p+Vector3.yAxis*((host.Config.Lift-state.Config.Lift)*Path.StudsPerMeter)
			end
			state.Data=Path.sample(state.Points,state.Config); state.Resolving=false
		end
		for _,state in order do resolve(state) end
		local groups={}
		local function anchor(approach)
			return if approach.End=='Start' then 0 elseif approach.End=='End' then approach.Data.Length else approach.At*approach.Data.Length
		end
		local function findGroup(state,distance)
			for _,group in groups do for _,approach in group do
				if approach.State==state and math.abs(anchor(approach)-distance)<.05 then return group end
			end end
		end
		local function add(group,state,at,endpoint)
			for _,approach in group do
				if approach.State==state then
					assert(approach.End==endpoint,'한 도로가 같은 교차로에 중복 진입합니다.')
					return
				end
			end
			table.insert(group,{State=state,Data=state.Data,At=at,End=endpoint})
		end
		for _,state in order do for _,link in state.Links do
			local host=states[link.Host]
			local group=findGroup(host,link.At*host.Data.Length)
			if not group then group={}; table.insert(groups,group); add(group,host,link.At) end
			add(group,state,nil,link.End)
		end end
		-- Interior crossings are derived from the sampled centerlines. Both
		-- roads retain their editable nodes and are rebuilt together after edits.
		for i,a in order do for j=i+1,#order do
			local b=order[j]
			for _,hit in Path.crossings(a.Data,b.Data) do
				local ga,gb=findGroup(a,hit.A),findGroup(b,hit.B)
				local group=ga or gb
				if ga and gb and ga~=gb then
					for _,approach in gb do add(ga,approach.State,approach.At,approach.End) end
					for k,candidate in groups do if candidate==gb then table.remove(groups,k); break end end
				end
				if not group then group={}; table.insert(groups,group) end
				add(group,a,hit.A/a.Data.Length); add(group,b,hit.B/b.Data.Length)
			end
		end end
		local planned,stats={},{T=0,Cross=0,Limited=0,LimitedArrows=0}
		local trafficSettings=if Traffic then (if trafficInput then Traffic.normalize(trafficInput) else Traffic.config(folder)) else nil
		for _,group in groups do
			local plan=Junctions.planApproaches(group)
			plan.Host,plan.Branch=group[1].State.Road,group[2].State.Road
			plan.End,plan.At=group[2].End or 'Cross',group[1].At
			for i,approach in group do table.insert(approach.State.Cuts,plan.Cuts[i]) end
			local kind=if #plan.Arms==4 then 'Cross' else 'T'; stats[kind]+=1
			table.insert(planned,plan)
		end
		for _,state in order do Junctions.checkCuts(state.Cuts) end
		local laneSerial=folder:GetAttribute('LaneSerial') or 0
		if LaneDirections then laneSerial=LaneDirections.bind(planned,previous,laneSerial,laneInput) end
		if Traffic then
			for _,plan in planned do
				local group=plan.Approaches
				for _,arm in plan.Arms do
					local portal=arm.Anchor+arm.Sign*arm.Trim
					local room=math.huge
					for _,cut in group[arm.Approach].State.Cuts do
						if cut~=plan.Cuts[arm.Approach] then
							local gap=if arm.Sign==1 then cut[1]-portal else portal-cut[2]
							if gap>0 then room=math.min(room,gap*.5-1) end
						end
					end
					arm.TrafficRoom=room
				end
				local decoration=Traffic.plan(plan,trafficSettings)
				stats.Limited+=decoration.Limited
				stats.LimitedArrows+=decoration.LimitedArrows or 0
				local reserved={}; for i,cut in plan.Cuts do reserved[i]={cut[1],cut[2]} end
				for _,cut in decoration.Cuts do
					table.insert(group[cut.Approach].State.MarkingCuts,cut.Range)
					local range=reserved[cut.Approach]; range[1],range[2]=math.min(range[1],cut.Range[1]),math.max(range[2],cut.Range[2])
				end
				for i,approach in group do table.insert(approach.State.ReservedCuts,reserved[i]) end
			end
		end
		for _,state in order do Junctions.checkCuts(state.Cuts); Junctions.checkCuts(state.ReservedCuts) end
		local staged={}; local junctionFolder=Instance.new('Folder'); junctionFolder.Name='Junctions'
		junctionFolder:SetAttribute('AssetKind','BoraRoadJunctions')
		local ok,err=pcall(function()
			for _,state in order do
				if state.Road==changed or #state.Cuts>0 or state.Road:GetAttribute('JunctionCut') or not samePoints(state.Points,state.Original) then
					state.Prepared=Roads.prepare(state.Points,state.Config,state.Cuts,state.MarkingCuts); table.insert(staged,state)
				end
			end
			for i,plan in planned do
				local model=Roads.junction(plan); model.Name=(if #plan.Arms==4 then 'XJunction_' else 'TJunction_')..i
				model.Parent=junctionFolder
				model:SetAttribute('Endpoint',plan.End); model:SetAttribute('At',plan.At)
				model:SetAttribute('ArmCount',#plan.Arms); model:SetAttribute('Center',plan.Center)
				if plan.Traffic then model:SetAttribute('LimitedApproaches',plan.Traffic.Limited) end
				if LaneDirections then LaneDirections.write(model,plan) end
				for key,road in {Host=plan.Host,Branch=plan.Branch} do local ref=Instance.new('ObjectValue'); ref.Name,ref.Value,ref.Parent=key,road,model end
				local members=Instance.new('Folder'); members.Name='Members'; members.Parent=model
				for n,approach in plan.Approaches do
					local ref=Instance.new('ObjectValue'); ref.Name,ref.Value='Road'..n,approach.State.Road
					ref:SetAttribute('At',approach.At); ref:SetAttribute('Endpoint',approach.End); ref.Parent=members
				end
				model.Parent=junctionFolder
			end
		end)
		if not ok then
			for _,state in staged do state.Prepared.Geometry:Destroy(); state.Prepared.Nodes:Destroy() end
			junctionFolder:Destroy(); error(err)
		end
		for _,state in staged do
			Roads.commit(state.Road,state.Prepared)
			state.Road:SetAttribute('JunctionCut',if #state.Cuts>0 then true else nil)
		end
		if changed and links then
			local old=changed:FindFirstChild('JunctionLinks'); if old then retire(old) end
			local saved=Instance.new('Folder'); saved.Name='JunctionLinks'
			for _,link in links do
				local ref=Instance.new('ObjectValue'); ref.Name,ref.Value=link.End,link.Host
				ref:SetAttribute('At',link.At); ref.Parent=saved
			end
			saved.Parent=changed
		end
		local old=folder:FindFirstChild('Junctions'); if old then retire(old) end
		junctionFolder.Parent=folder; folder:SetAttribute('JunctionVersion',2)
		if LaneDirections then folder:SetAttribute('LaneSerial',laneSerial) end
		if trafficSettings then for key,value in trafficSettings do folder:SetAttribute(key,value) end end
		return #planned,stats
	end
	function Network.edit(folder,road,points,config,reconnect)
		local links
		if reconnect then points,links=Network.attachEnds(folder,points,road) end
		return Network.apply(folder,road,points,config,links)
	end
	function Network.setLane(folder,junction,road,sign,lane,mask)
		assert(LaneDirections,'차로 편집 모듈이 없습니다.')
		return Network.apply(folder,nil,nil,nil,nil,nil,{Junction=junction,Road=road,Sign=sign,Lane=lane,Mask=mask})
	end
	return Network
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name"><![CDATA[RoadTraffic]]></string>
        <string name="Source"><![CDATA[-- Distances in the inspector are meters. Markings follow the actual road
-- samples beyond each junction portal, including slopes and curved approaches.
return function(api,Path,LaneDirections,Assets)
	local V,Instance,CFrame,Color3,Enum=api.Vector3,api.Instance,api.CFrame,api.Color3,api.Enum
	local T={}
	assert(Assets and Assets.Vehicle and Assets.Pedestrian,'Missing measured signal asset layout')
	T.AssetLayout=Assets
	T.Defaults={Crosswalks=true,StopLines=true,Signals=true,PedestrianSignals=true,CrosswalkWidth=3,CrosswalkOffset=.6,StopGap=1,GreenSeconds=12,LeftSeconds=8,WalkSeconds=10,FlashSeconds=4}
	T.Limits={CrosswalkWidth={2,6},CrosswalkOffset={0,5},StopGap={.5,4},GreenSeconds={5,60},LeftSeconds={4,40},WalkSeconds={6,60},FlashSeconds={2,10}}
	function T.normalize(input)
		local out={}
		for key,value in T.Defaults do
			local x=if input[key]==nil then value else input[key]
			if type(value)=='boolean' then assert(type(x)=='boolean',key..' 설정을 확인하세요.')
			else local bounds=T.Limits[key]; assert(type(x)=='number' and x==x and x>=bounds[1] and x<=bounds[2],key..' 범위를 확인하세요.') end
			out[key]=x
		end
		return out
	end
	function T.config(folder)
		local input={}; for key in T.Defaults do input[key]=folder:GetAttribute(key) end
		return T.normalize(input)
	end
	function T.savedMask(junction,index)
		local rules=junction:FindFirstChild('LaneDirections')
		if rules then for _,rule in rules:GetChildren() do if rule:GetAttribute('Arm')==index then
			local mask=0
			for lane=1,rule:GetAttribute('Count') or 0 do mask=bit32.bor(mask,rule:GetAttribute('Lane'..lane) or 0) end
			if mask>0 then return mask end
		end end end
	end
	local function section(arm,outward)
		local s=Path.at(arm.Data,arm.Anchor+arm.Sign*(arm.Trim+outward))
		local p=s.P+V.yAxis*(arm.Data.Config.Lift*Path.StudsPerMeter+.045)
		return p,s.Side*(arm.Sign*s.Miter)
	end
	function T.plan(plan,input)
		local settings=T.normalize(input); local scale=Path.StudsPerMeter
		local result={Settings=settings,Markings={},Signals={},Pedestrians={},Cuts={},Limited=0}
		local offset=settings.CrosswalkOffset*scale
		local depth=if settings.Crosswalks then settings.CrosswalkWidth*scale else 0
		local stopStart=offset+depth+settings.StopGap*scale
		local reach=if settings.StopLines then stopStart+.4*scale elseif settings.Crosswalks then offset+depth else 0
		for index,arm in plan.Arms do
			local remaining=if arm.Sign==1 then arm.Data.Length-arm.Anchor-arm.Trim else arm.Anchor-arm.Trim
			remaining=math.min(remaining,arm.TrafficRoom or math.huge)
			local paint=reach==0 or remaining>reach+1
			if not paint then result.Limited+=1 end
			local function quad(kind,a,b,left,right)
				local p,u=section(arm,a); local q,v=section(arm,b)
				table.insert(result.Markings,{Kind=kind,Corners={p+u*left,p+u*right,q+v*right,q+v*left},Arm=index})
			end
			if settings.Crosswalks and paint then
				local edge=.2*scale
				local width=2*arm.Half-2*edge
				local n=math.max(2,math.floor(width/scale))
				local pitch=width/n; local stripe=math.min(.5*scale,pitch*.55)
				for i=1,n do
					local lateral=-arm.Half+edge+pitch*(i-.5)
					-- Slice long stripes so they stay on a bend or slope.
					for s=1,3 do quad('Crosswalk',offset+depth*(s-1)/3,offset+depth*s/3,lateral-stripe*.5,lateral+stripe*.5) end
				end
				if settings.PedestrianSignals then
					local p,u=section(arm,offset+depth*.5)
					local lateral=arm.Half+math.max(arm.Walk*.5,.45*scale)
					for _,sign in {-1,1} do
						table.insert(result.Pedestrians,{Position=p+u*(sign*lateral),Direction=-u.Unit*sign,Arm=index,Side=sign})
					end
				end
			end
			if settings.StopLines and paint then
				-- Path.Side is outward-right. Approaching cars use its negative
				-- half in right-hand traffic; a one-lane alley uses its full width.
				local lanes=Path.lanes(arm.Data.Config,arm.Sign)
				local right=if arm.Data.Config.Lanes==1 then arm.Half-.15*scale else arm.Sign*lanes.Divider-.15*scale
				quad('StopLine',stopStart,stopStart+.4*scale,-arm.Half+.15*scale,right)
			end
			if reach>0 and paint then
				local a,b=arm.Anchor+arm.Sign*arm.Trim,arm.Anchor+arm.Sign*(arm.Trim+reach+.15*scale)
				table.insert(result.Cuts,{Approach=arm.Approach,Range={math.min(a,b),math.max(a,b)}})
			end
			if settings.Signals then
				local p,left=section(arm,offset*.5)
				local direction=V.new(left.Z,0,-left.X).Unit
				local phase=if math.abs(arm.Direction:Dot(plan.Arms[1].Direction))>.72 then 1 else 2
				local mask=0
				if plan.LaneRules then for _,value in plan.LaneRules[index].Masks do mask=bit32.bor(mask,value) end
				else
					-- Older callers without lane rules retain straight phases when
					-- there is an opposing exit, turns at a terminating approach.
					for _,other in plan.Arms do if other~=arm then
						local incoming=-arm.Direction
						local cross=incoming.X*other.Direction.Z-incoming.Z*other.Direction.X
						mask=bit32.bor(mask,if incoming:Dot(other.Direction)>.72 then 1 elseif cross<0 then 2 else 4)
					end end
					if bit32.band(mask,1)~=0 then mask=1 end
				end
				table.insert(result.Signals,{Position=p-left*(arm.Half+math.max(arm.Walk*.5,.45*scale)),Direction=direction,Side=left.Unit,Half=arm.Half,Phase=phase,Arm=index,Mask=mask})
			end
		end
		if LaneDirections and plan.LaneRules then LaneDirections.decorate(plan,settings,result,section) end
		plan.Traffic=result
		return result
	end
	local function part(parent,name,size,frame,color,collide)
		local item=Instance.new('Part'); item.Name,item.Size,item.CFrame,item.Color=name,size,frame,color
		item.Anchored,item.CanCollide,item.CanTouch,item.CanQuery=true,collide,false,collide
		item.Material=Enum.Material.SmoothPlastic; item.TopSurface,item.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
		item.Parent=parent; return item
	end
	function T.configureSignal(model,arm,mask)
		assert(mask and mask>=1 and mask<=7,'Missing lane directions for signal')
		model:SetAttribute('Arm',arm);model:SetAttribute('MovementMask',mask)
		model:SetAttribute('SignalProgramVersion',2);model:SetAttribute('RightTurnPolicy','StopAndYield')
		model:SetAttribute('StraightAllowed',false);model:SetAttribute('LeftAllowed',false)
		model:SetAttribute('RightTurnAllowed',false);model:SetAttribute('RightTurnMustYield',bit32.band(mask,4)~=0)
		model:SetAttribute('LightState',nil)
		local scale=Path.StudsPerMeter;local frame=model.TripoHead.CFrame
		for i,name in {'Red','Amber','Green'} do
			local center=if name=='Green' and bit32.band(mask,2)~=0 then Assets.Vehicle.ExtensionCenter else Assets.Vehicle.Centers[i]
			model[name].CFrame=frame*CFrame.new(V.new(table.unpack(center))*scale)
		end
		if bit32.band(mask,2)==0 then return end
		-- Use the third Tripo cup for the arrow, adding a fourth matching
		-- housing for straight green. Keep the existing pole/mount/head intact.
		local housing=model:FindFirstChild('GreenHousing')
		if not housing then housing=part(model,'GreenHousing',V.new(.74,.73,1.15)*scale,frame,Color3.new(1,1,1),false) end
		housing.Size,housing.CFrame,housing.Color=V.new(.74,.73,1.15)*scale,frame,Color3.new(1,1,1)
		local mesh=housing:FindFirstChildOfClass('SpecialMesh')
		if not mesh then mesh=Instance.new('SpecialMesh');mesh.Parent=housing end
		mesh.MeshType=Enum.MeshType.FileMesh;mesh.MeshId='rbxasset://BoraRoadKit/TrafficSignalExtension.mesh'
		mesh.TextureId='rbxasset://BoraRoadKit/TrafficSignal.png';mesh.Scale=V.one*scale
		local center=V.new(table.unpack(Assets.Vehicle.Centers[3]))
		local backing=model:FindFirstChild('LeftBacking') or part(model,'LeftBacking',V.new(.33,.33,.025)*scale,frame,Color3.fromRGB(12,16,14),false)
		backing.CFrame=frame*CFrame.new((center-V.zAxis*.005)*scale)
		local arrow=model:FindFirstChild('Left')
		if not arrow then arrow=Instance.new('Folder');arrow.Name,arrow.Parent='Left',model end
		arrow:SetAttribute('SignalLamp','Left')
		for i,line in {{-.11,0,.10,0},{.10,0,.015,.085},{.10,0,.015,-.085}} do
			local a,b=V.new(line[1],line[2],0),V.new(line[3],line[4],0)
			local delta=b-a
			local segment=arrow:FindFirstChild('Segment'..i) or part(arrow,'Segment'..i,V.new(delta.Magnitude,.035,.015)*scale,frame,Color3.fromRGB(21,25,24),false)
			segment.CFrame=frame*CFrame.new((center-V.zAxis*.032+(a+b)*.5)*scale)*CFrame.Angles(0,0,math.atan2(delta.Y,delta.X))
		end
	end
	local function glyph(parent,frame,center,walking,scale)
		local group=Instance.new('Folder'); group.Name=if walking then 'WalkIcon' else 'StopIcon'; group.Parent=parent
		local color=if walking then Color3.fromRGB(45,245,119) else Color3.fromRGB(255,52,39)
		local points=if walking then {
			{0,.055,-.008,-.005},{-.008,-.005,-.042,-.04},{-.042,-.04,-.065,-.075},
			{-.008,-.005,.026,-.032},{.026,-.032,.06,-.045},
			{0,.05,-.027,.025},{-.027,.025,-.052,.043},{0,.05,.028,.07},{.028,.07,.057,.048},
		} else {
			{0,.06,0,-.015},{-.006,-.015,-.023,-.095},{.006,-.015,.023,-.095},
			{0,.055,-.035,.012},{0,.055,.035,.012},
		}
		local function point(x,y) return center+V.new(x,y,0)*scale end
		for i,line in points do
			local a,b=point(line[1],line[2]),point(line[3],line[4]); local delta=b-a
			local angle=math.atan2(delta.Y,delta.X)
			local item=part(group,'Segment'..i,V.new(delta.Magnitude,.018*scale,.009*scale),frame*CFrame.new((a+b)*.5)*CFrame.Angles(0,0,angle),color,false)
			item.Material=Enum.Material.Neon; item.Transparency=if walking then 1 else 0
		end
		local head=part(group,'Head',V.new(.044,.044,.009)*scale,frame*CFrame.new(point(0,.105)),color,false)
		local sphere=Instance.new('SpecialMesh'); sphere.MeshType=Enum.MeshType.Sphere; sphere.Parent=head
		head.Material=Enum.Material.Neon; head.Transparency=if walking then 1 else 0
	end
	function T.buildPedestrians(parent,plan)
		local folder=Instance.new('Folder'); folder.Name,folder.Parent='PedestrianSignals',parent
		local scale=Path.StudsPerMeter
		for _,signal in plan.Traffic.Pedestrians do
			local model=Instance.new('Model'); model.Name='Pedestrian_'..signal.Arm..'_'..(if signal.Side>0 then 'Right' else 'Left'); model.Parent=folder
			local layout=Instance.new('StringValue');layout.Name='BoraDisplayLayout';layout.Value=Assets.Pedestrian.LayoutJson;layout.Parent=model
			model:SetAttribute('CrosswalkArm',signal.Arm); model:SetAttribute('SignalKind','Pedestrian'); model:SetAttribute('AssetSource','Tripo Studio')
			local pole=signal.Position+V.yAxis*(.12*scale-.045)
			part(model,'Base',V.new(.3,.12,.3)*scale,CFrame.new(pole+V.yAxis*(.06*scale)),Color3.fromRGB(98,103,105),true)
			part(model,'Pole',V.new(.10,2.6,.10)*scale,CFrame.new(pole+V.yAxis*(1.3*scale)),Color3.fromRGB(131,139,139),true)
			local position=pole+V.yAxis*(2.1*scale)+signal.Direction*(.12*scale)
			local frame=CFrame.lookAt(position,position+signal.Direction)
			local head=part(model,'TripoPedestrianHead',V.new(table.unpack(Assets.Pedestrian.Bounds))*scale,frame,Color3.new(1,1,1),false)
			local mesh=Instance.new('SpecialMesh'); mesh.MeshType=Enum.MeshType.FileMesh
			mesh.MeshId='rbxasset://BoraRoadKit/PedestrianSignal.mesh'; mesh.TextureId='rbxasset://BoraRoadKit/PedestrianSignal.png'; mesh.Scale=V.one*scale; mesh.Parent=head
			-- Display centers are calibrated against the generated Tripo mesh.
			glyph(model,frame,V.new(table.unpack(Assets.Pedestrian.Centers[1]))*scale,false,scale)
			glyph(model,frame,V.new(table.unpack(Assets.Pedestrian.Centers[2]))*scale,true,scale)
		end
	end
	function T.buildSignals(parent,plan)
		local folder=Instance.new('Folder'); folder.Name,folder.Parent='Signals',parent
		for _,signal in plan.Traffic.Signals do
			local scale=Path.StudsPerMeter
			local model=Instance.new('Model'); model.Name='Signal_'..signal.Arm
			model:SetAttribute('Phase',signal.Phase); model:SetAttribute('AssetSource','Tripo Studio'); model.Parent=folder
			local poleHeight=5.5*scale
			local pole=signal.Position-V.yAxis*.045
			part(model,'Base',V.new(.48,.18,.48)*scale,CFrame.new(pole+V.yAxis*(.09*scale)),Color3.fromRGB(98,103,105),true)
			part(model,'Pole',V.new(.16*scale,poleHeight,.16*scale),CFrame.new(pole+V.yAxis*(poleHeight*.5)),Color3.fromRGB(131,139,139),true)
			-- The head faces outward toward approaching traffic. Its long local X
			-- axis runs across the lane; its front is local -Z.
			local headPosition=pole+V.yAxis*(poleHeight-.35*scale)+signal.Side*(signal.Half*.7)
			local frame=CFrame.lookAt(headPosition,headPosition+signal.Direction)
			local mount=(pole+V.yAxis*(poleHeight-.35*scale)+headPosition)*.5
			part(model,'Arm',V.new(.13*scale,.13*scale,(headPosition-(pole+V.yAxis*(poleHeight-.35*scale))).Magnitude),CFrame.lookAt(mount,headPosition),Color3.fromRGB(131,139,139),false)
			local head=part(model,'TripoHead',V.new(table.unpack(Assets.Vehicle.Bounds))*scale,frame,Color3.new(1,1,1),false)
			local mesh=Instance.new('SpecialMesh'); mesh.MeshType=Enum.MeshType.FileMesh
			mesh.MeshId='rbxasset://BoraRoadKit/TrafficSignal.mesh'; mesh.TextureId='rbxasset://BoraRoadKit/TrafficSignal.png'
			mesh.Scale=V.one*scale; mesh.Parent=head
			-- Lens positions are calibrated against the generated mesh asset.
			for i,name in {'Red','Amber','Green'} do
				local lens=part(model,name,V.new(.30,.30,.035)*scale,frame*CFrame.new((2-i)*.66*scale,-.03*scale,-.418*scale),if name=='Red' then Color3.fromRGB(255,52,39) else Color3.fromRGB(25,29,28),false)
				if name=='Red' then lens.Material=Enum.Material.Neon end
				local sphere=Instance.new('SpecialMesh'); sphere.MeshType=Enum.MeshType.Sphere; sphere.Parent=lens
				lens:SetAttribute('SignalLamp',name)
			end
			T.configureSignal(model,signal.Arm,signal.Mask)
		end
		T.buildPedestrians(parent,plan)
	end
	return T
end
]]></string>
      </Properties>
