<roblox version="4">
  <Item class="Model" referent="0">
    <Properties>
      <string name="Name"><![CDATA[BoraVehicleKit]]></string>
      <BinaryString name="AttributesSerialize">AQAAAAcAAABWZXJzaW9uAgUAAAAwLjEuMA==</BinaryString>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name"><![CDATA[VehicleFactory]]></string>
        <string name="Source"><![CDATA[-- Native asset parts are grouped around separate functional pivots.
return function(api,Catalog)
	local I,V,C,E,Color=api.Instance,api.Vector3,api.CFrame,api.Enum,api.Color3
	local F={Scale=1/.28}
	function F.create(ground)
		local scale=F.Scale;ground=ground or C.new()
		local car=I.new('Model');car.Name='BoraSedan_S1'
		car:SetAttribute('AssetKind','BoraVehicle');car:SetAttribute('VehicleId','BoraSedan01')
		car:SetAttribute('Version',Catalog.Version or 1);car:SetAttribute('Lifecycle','Empty');car:SetAttribute('Design',Catalog.Design or 'BORA S1 compact sedan')
		local revision=I.new('StringValue');revision.Name='BoraVisualRevision';revision.Value=tostring(Catalog.VisualRevision or 1)..':'..(Catalog.VisualHash or '');revision.Parent=car
		if Catalog.LayoutJson then local layout=I.new('StringValue');layout.Name='BoraModelLayout';layout.Value=Catalog.LayoutJson;layout.Parent=car end
		local function part(name,size,frame,parent,visible)
			local p=I.new('Part');p.Name,p.Size,p.CFrame,p.Parent=name,size,frame,parent
			p.Anchored=false;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true
			p.Transparency=if visible then 0 else 1;p.TopSurface,p.BottomSurface=E.SurfaceType.Smooth,E.SurfaceType.Smooth
			p.Material=E.Material.SmoothPlastic;return p
		end
		local root=part('Chassis',V.new(1.55,.34,3.75)*scale,ground*C.new(0,.62*scale,0),car,false)
		root.CanCollide,root.CanQuery,root.Massless=true,true,false;root.RootPriority=127
		root.CustomPhysicalProperties=api.PhysicalProperties.new(1,.25,0,100,100)
		car.PrimaryPart=root
		local groups=I.new('Folder');groups.Name,groups.Parent='Components',car
		local mechanics=I.new('Folder');mechanics.Name,mechanics.Parent='Mechanics',car
		local hubs={}
		for name,pivot in Catalog.Pivots do
			local folder=I.new('Model');folder.Name,folder.Parent=name,groups
			local pos=V.new(table.unpack(pivot))*scale
			local hub=part('Pivot',V.one*.06,ground*C.new(pos),folder,false);folder.PrimaryPart=hub;hubs[name]=hub
			local joint=I.new(if name=='Body' then 'Weld' else 'Motor6D');joint.Name=name
			joint.Part0,joint.Part1,joint.C0,joint.C1,joint.Parent=root,hub,root.CFrame:ToObjectSpace(hub.CFrame),C.new(),mechanics
			joint:SetAttribute('ClosedC0',joint.C0)
		end
		for index,item in Catalog.Parts do
			local hub=hubs[item.Group]
			local p=part(item.Material..'_'..index,V.new(table.unpack(item.Bounds))*scale,hub.CFrame,hub.Parent,true)
			p.Color=Color.fromRGB(table.unpack(item.Color));p.Transparency=item.Transparency
			if item.Material=='Paint' or item.Material=='CarPaint' then p.Reflectance=.08 end
			p.CastShadow=item.Material~='Glass'
			if item.Material=='Glass' then p.Material=E.Material.Glass;p.Reflectance=.04 end
			if table.find({'LED','Tail','Amber','Screen'},item.Material) then p.Material=E.Material.Neon end
			if item.RobloxMaterial then p.Material=E.Material[item.RobloxMaterial] end
			local mesh=I.new('SpecialMesh');mesh.MeshType=E.MeshType.FileMesh
			mesh.MeshId='rbxasset://BoraVehicleKit/'..item.File;mesh.Scale=V.one*scale;mesh.Parent=p
			if item.Texture then mesh.TextureId='rbxasset://BoraVehicleKit/'..item.Texture end
			local weld=I.new('WeldConstraint');weld.Part0,weld.Part1,weld.Parent=hub,p,p
		end
		local function marker(name,pos,parent)
			local a=I.new('Attachment');a.Name,a.CFrame,a.Parent=name,C.new(V.new(table.unpack(pos))*scale),parent or root;return a
		end
		local markers=Catalog.Markers or {}
		marker('Eye',markers.Eye or {-.43,1.20-.62,.08});marker('SeatedRoot',markers.SeatedRoot or {-.43,.87-.62,.22})
		marker('OutsideDriver',markers.OutsideDriver or {-1.35,.95-.62,-.02})
		marker('DriverHandle',markers.DriverHandle or {-1.0,.83-.62,.10})
		marker('LeftGrip',{-.16,0,0},hubs.Steering);marker('RightGrip',{.16,0,0},hubs.Steering)
		for code,pos in {FL={-.795,-.02,-1.36},FR={.795,-.02,-1.36},RL={-.795,-.02,1.36},RR={.795,-.02,1.36}} do marker('Suspension'..code,markers['Suspension'..code] or pos) end
		local seat=I.new('VehicleSeat');seat.Name='DriverSeat';seat.Size=V.new(.46,.12,.42)*scale
		seat.CFrame=ground*C.new(V.new(table.unpack(Catalog.SeatPosition or {-.43,.43,.24}))*scale)
		seat.Transparency,seat.CanCollide,seat.CanTouch,seat.Massless=1,false,false,true
		seat.Disabled,seat.HeadsUpDisplay,seat.Torque,seat.MaxSpeed=true,false,0,0;seat.Parent=car
		local weld=I.new('WeldConstraint');weld.Part0,weld.Part1,weld.Parent=root,seat,seat
		local driver=I.new('ObjectValue');driver.Name,driver.Parent='Driver',car
		for _,name in {'DoorFL','DoorFR','DoorRL','DoorRR'} do
			local hub=hubs[name];local point=marker('DoorPrompt',{if name:sub(-1)=='L' then -.09 else .09,0,.62},hub)
			local prompt=I.new('ProximityPrompt');prompt.Name='Interact';prompt.ActionText=if name=='DoorFL' then '탑승' else '문 열기 / 닫기'
			prompt.ObjectText=if name=='DoorFL' then 'BORA 세단 · 운전석' else 'BORA 세단 · '..(if name:sub(5,5)=='F' then '앞문' else '뒷문')
			prompt.KeyboardKeyCode=E.KeyCode.E;prompt.HoldDuration=.15;prompt.MaxActivationDistance=12;prompt.RequiresLineOfSight=false;prompt.Parent=point
		end
		local dash=part('DashboardDisplay',V.new(.32,.005,.13)*scale,ground*C.new(V.new(-.45,.97,-.532)*scale)*C.Angles(math.pi/2,0,0),car,false)
		local dw=I.new('WeldConstraint');dw.Part0,dw.Part1,dw.Parent=root,dash,dash
		local gui=I.new('SurfaceGui');gui.Name,gui.Face,gui.Parent='SpeedDisplay',E.NormalId.Top,dash
		gui.AlwaysOnTop=false;gui.LightInfluence=0;gui.SizingMode=E.SurfaceGuiSizingMode.PixelsPerStud;gui.PixelsPerStud=220
		local label=I.new('TextLabel');label.Name,label.Text,label.Size='Speed','0  km/h',api.UDim2.fromScale(1,1)
		label.BackgroundTransparency=1;label.TextColor3=Color.fromRGB(205,238,255);label.TextScaled=true;label.Font=E.Font.GothamMedium;label.Parent=gui
		gui.SizingMode=E.SurfaceGuiSizingMode.FixedSize;gui.CanvasSize=api.Vector2.new(480,200)
		local function text(parent,name,value,x,y,w,h,color)
			local t=I.new('TextLabel');t.Name,t.Text,t.Parent=name,value,parent;t.Size=api.UDim2.fromScale(w,h);t.Position=api.UDim2.fromScale(x,y)
			t.BackgroundTransparency=1;t.TextColor3=color or Color.fromRGB(209,224,234);t.TextScaled=true;t.Font=E.Font.GothamMedium;return t
		end
		local function rect(parent,x,y,w,h,color)
			local f=I.new('Frame');f.Size=api.UDim2.fromScale(w,h);f.Position=api.UDim2.fromScale(x,y);f.BorderSizePixel=0;f.BackgroundColor3=color;f.Parent=parent;return f
		end
		local background=rect(gui,0,0,1,1,Color.fromRGB(9,16,24));background.ZIndex=0
		label.Size=api.UDim2.fromScale(.40,.37);label.Position=api.UDim2.fromScale(.30,.34)
		text(gui,'Brand','B O R A',.35,.04,.30,.12)
		text(gui,'Gear','P',.46,.19,.08,.16,Color.fromRGB(103,221,228))
		text(gui,'Range','RANGE   342 km',.31,.82,.38,.10)
		text(gui,'RPM','RPM ×1000',.03,.71,.22,.11)
		text(gui,'Fuel','FUEL',.79,.71,.16,.11)
		local blue=Color.fromRGB(75,198,229)
		for i=0,12 do
			local a=math.rad(210-i*20);local tick=rect(gui,.16+math.cos(a)*.105,.46+math.sin(a)*.24,.008,.048,if i<10 then blue else Color.fromRGB(242,104,92));tick.Rotation=-math.deg(a)+90
		end
		for i=0,7 do rect(gui,.81+i*.012,.34,.008,.28,if i<6 then blue else Color.fromRGB(38,54,66)) end
		local center=part('CenterDisplay',V.new(.41,.005,.13)*scale,ground*C.new(V.new(.02,.97,-.532)*scale)*C.Angles(math.pi/2,0,0),car,false)
		local cw=I.new('WeldConstraint');cw.Part0,cw.Part1,cw.Parent=root,center,center
		local screen=I.new('SurfaceGui');screen.Name,screen.Face,screen.Parent='Infotainment',E.NormalId.Top,center;screen.LightInfluence=0;screen.SizingMode=E.SurfaceGuiSizingMode.FixedSize;screen.CanvasSize=api.Vector2.new(620,200)
		rect(screen,0,0,1,1,Color.fromRGB(12,22,32))
		text(screen,'Title','BORA   |   DRIVE',.04,.05,.52,.15)
		text(screen,'Status','주행 준비',.04,.35,.45,.28)
		text(screen,'Subtitle','차량 상태 · 안전 운전',.04,.70,.48,.13,Color.fromRGB(141,166,183))
		rect(screen,.61,.15,.003,.68,Color.fromRGB(44,66,82))
		text(screen,'Media','♫  미디어',.67,.22,.28,.19)
		text(screen,'Climate','22.0°   AUTO',.67,.57,.28,.19,blue)
		if Catalog.Screens then
			for name,spec in Catalog.Screens do
				local display=car[name];local tilt=math.rad(spec.Tilt)
				local normal=V.new(0,math.sin(tilt),math.cos(tilt));local position=V.new(table.unpack(spec.Position))+normal*.0025
				display.Size=V.new(spec.Size[1],spec.Size[2],.002)*scale
				display.CFrame=ground*C.lookAt(position*scale,(position+normal)*scale,V.new(0,math.cos(tilt),-math.sin(tilt)))
			end
			-- Keep the approved navigation graphic; only speed/gear are live overlays.
			screen.Enabled=false;gui.Face=E.NormalId.Front;gui.CanvasSize=api.Vector2.new(1200,480)
			for _,item in gui:GetChildren() do if item:IsA('GuiObject') and item~=label and item.Name~='Gear' then item.Visible=false end end
			label.Size=api.UDim2.fromScale(.19,.31);label.Position=api.UDim2.fromScale(.13,.29)
			label.Text='0';label.BackgroundTransparency=0;label.BackgroundColor3=Color.fromRGB(7,13,19)
			local gear=gui.Gear;gear.Size=api.UDim2.fromScale(.16,.32);gear.Position=api.UDim2.fromScale(.695,.29)
			gear.BackgroundTransparency=0;gear.BackgroundColor3=Color.fromRGB(7,13,19)
			car:SetAttribute('NumericInstrumentSpeed',true)
		end
		car:SetAttribute('MeshTriangles',Catalog.TotalTriangles)
		return car
	end
	return F
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name"><![CDATA[VehicleDynamics]]></string>
        <string name="Source"><![CDATA[-- Pure controls/physics rules; all distances are Roblox studs.
local D={Scale=1/.28,Wheelbase=2.75/.28,Radius=.344/.28,RideHeight=.62/.28,
	ProbeUp=1/.28,ProbeDown=3/.28,MaxStep=.22/.28,MaxDrop=.35/.28,MaxSlope=math.tan(math.rad(26))}
local function finite(x) return type(x)=='number' and x==x and math.abs(x)<math.huge end
function D.input(data)
	if type(data)~='table' or not finite(data.Throttle) or not finite(data.Steer) or type(data.Brake)~='boolean' then return nil end
	if math.abs(data.Throttle)>1 or math.abs(data.Steer)>1 then return nil end
	return {Throttle=data.Throttle,Steer=data.Steer,Brake=data.Brake}
end
function D.control(speed,input)
	local mps=speed/D.Scale
	local angle=-input.Steer*math.rad(34)/(1+math.abs(mps)/16)
	local acceleration
	if input.Brake then acceleration=-math.clamp(mps*7,-16,16)
	elseif input.Throttle*mps<-.4 then acceleration=input.Throttle*12
	elseif input.Throttle~=0 then
		local limit=if input.Throttle>0 then 30 else 7
		acceleration=input.Throttle*7*math.clamp(1-math.abs(mps)/limit,0,1)
	else acceleration=-math.clamp(mps*1.2,-.8,.8) end
	return acceleration*D.Scale,angle
end
function D.canEnter(state,speed,healthy,distance)
	return state=='Empty' and math.abs(speed)<1 and healthy and distance<=12
end
function D.exitReady(speed) return math.abs(speed)<1.5 end
function D.wheelAngle(steer,x)
	if math.abs(steer)<.0001 then return 0 end
	local radius=D.Wheelbase/math.tan(steer)
	return math.atan(D.Wheelbase/(radius+x))
end
return D
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name"><![CDATA[VehiclePhysics]]></string>
        <string name="Source"><![CDATA[-- Stable ground-following arcade motion. Wheels are visual, not suspension.
return function(api,D)
	local V,C=api.Vector3,api.CFrame
	local P={}
	local codes={'FL','FR','RL','RR'}
	local function forward(yaw) return V.new(-math.sin(yaw),0,-math.cos(yaw)) end
	local function pose(position,yaw,up)
		local f=forward(yaw);f=(f-up*f:Dot(up)).Unit
		local right=f:Cross(up).Unit
		return C.fromMatrix(position,right,right:Cross(f).Unit,-f)
	end
	function P.new(car,world,rayParams)
		local root=car.Chassis
		local self={Car=car,Root=root,Speed=0,Spin=0,Steer=0}
		local wheels={}
		for _,code in codes do
			local joint=car.Mechanics['Wheel'..code]
			wheels[code]={Joint=joint,Closed=joint:GetAttribute('ClosedC0')}
		end
		function self:reset()
			self.Speed=0;self.Steer=0
			local f=root.CFrame.LookVector
			self.Yaw=math.atan2(-f.X,-f.Z)
			self.Ground=nil
		end
		self:reset()
		local function ground(position,yaw)
			local heading=C.new(position)*C.Angles(0,yaw,0)
			local points={};local centerHit=false;local normal=V.zero
			local function probe(offset,center)
				local p=heading:PointToWorldSpace(offset)
				local hit=world:Raycast(p+V.yAxis*D.ProbeUp,-V.yAxis*(D.ProbeUp+D.ProbeDown),rayParams)
				if not hit or hit.Normal.Y<.88 then return end
				local h=hit.Position
				table.insert(points,{X=h.X-position.X,Z=h.Z-position.Z,Y=h.Y})
				normal+=hit.Normal
				if center then centerHit=true end
			end
			probe(V.zero,true)
			for _,code in codes do
				local p=wheels[code].Closed.Position
				probe(V.new(p.X,0,p.Z),false)
			end
			if #points==0 or (not centerHit and #points<3) then return nil end
			local n=#points;local sx,sz,sy,sxx,szz,sxz,sxy,szy=0,0,0,0,0,0,0,0
			for _,p in points do
				sx+=p.X;sz+=p.Z;sy+=p.Y;sxx+=p.X*p.X;szz+=p.Z*p.Z;sxz+=p.X*p.Z;sxy+=p.X*p.Y;szy+=p.Z*p.Y
			end
			local xx,zz,xz=sxx-sx*sx/n,szz-sz*sz/n,sxz-sx*sz/n
			local xy,zy=sxy-sx*sy/n,szy-sz*sy/n
			local det=xx*zz-xz*xz
			local a,b
			if math.abs(det)>.00001 then a,b=(xy*zz-zy*xz)/det,(zy*xx-xy*xz)/det
			else normal=normal.Unit;a,b=-normal.X/normal.Y,-normal.Z/normal.Y end
			if a*a+b*b>D.MaxSlope*D.MaxSlope then return nil end
			local y=(sy-a*sx-b*sz)/n
			-- Keep the rigid wheel plane above small unevenness without springs.
			for _,p in points do y=math.max(y,p.Y-a*p.X-b*p.Z) end
			return {Y=y,Up=V.new(-a,1,-b).Unit}
		end
		function self:step(dt,input)
			dt=math.clamp(dt,0,.05);if dt==0 then return end
			root.Anchored=true
			root.AssemblyLinearVelocity=V.zero;root.AssemblyAngularVelocity=V.zero
			local old=root.CFrame.Position
			local current=ground(old,self.Yaw)
			if not current then self.Speed=0;car:SetAttribute('SpeedKmh',0);return end
			local acceleration,target=D.control(self.Speed,input)
			local before=self.Speed
			self.Speed+=acceleration*dt
			if (input.Brake or input.Throttle==0) and before*self.Speed<0 then self.Speed=0 end
			self.Steer+=(target-self.Steer)*(1-math.exp(-dt*12))
			local rate=self.Speed/D.Wheelbase*math.tan(self.Steer)
			local limit=math.rad(100)/(1+math.abs(self.Speed/D.Scale)/35)
			rate=math.clamp(rate,-limit,limit)
			local turn=rate*dt
			local movement=forward(self.Yaw+turn*.5)*self.Speed*dt
			local targetPosition=old+movement
			local nextGround=ground(targetPosition,self.Yaw+turn)
			local rise=if nextGround then nextGround.Y-current.Y else math.huge
			if not nextGround or rise>D.MaxStep+movement.Magnitude*D.MaxSlope or -rise>D.MaxDrop+movement.Magnitude*D.MaxSlope then
				movement=V.zero;turn=0;self.Speed=0;nextGround=current
			elseif movement.Magnitude>.00001 then
				local start=V.new(old.X,current.Y+D.RideHeight/current.Up.Y,old.Z)
				local cast=pose(start,self.Yaw+turn*.5,current.Up)*C.new(0,.22*D.Scale,0)
				local endY=nextGround.Y+D.RideHeight/nextGround.Up.Y
				local delta=V.new(movement.X,endY-start.Y,movement.Z)
				local hit=world:Blockcast(cast,V.new(1.9,1.2,4.65)*D.Scale,delta+delta.Unit*(.06*D.Scale),rayParams)
				if hit then
					local fraction=math.clamp((hit.Distance-.06*D.Scale)/delta.Magnitude,0,1)
					movement*=fraction;turn*=fraction;self.Speed=0
					nextGround=ground(old+movement,self.Yaw+turn) or current
				end
			end
			self.Yaw+=turn;self.Ground=nextGround
			local position=V.new(old.X+movement.X,nextGround.Y+D.RideHeight/nextGround.Up.Y,old.Z+movement.Z)
			root.CFrame=pose(position,self.Yaw,nextGround.Up)
			local distance=movement:Dot(forward(self.Yaw-turn*.5))
			self.Spin=(self.Spin-distance/D.Radius)%(math.pi*2)
			for _,code in codes do
				local w=wheels[code]
				local steer=if code:sub(1,1)=='F' then D.wheelAngle(self.Steer,w.Closed.Position.X) else 0
				w.Joint.C0=w.Closed*C.Angles(0,steer,0)*C.Angles(self.Spin,0,0)
			end
			car.Mechanics.Steering.C0=car.Mechanics.Steering:GetAttribute('ClosedC0')*C.fromAxisAngle(V.new(0,.5,.866025404),self.Steer*4)
			car:SetAttribute('SpeedKmh',math.floor(math.abs(self.Speed)/D.Scale*3.6+.5))
		end
		return self
	end
	return P
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="4">
      <Properties>
        <string name="Name"><![CDATA[ServerTemplate]]></string>
        <bool name="Disabled">true</bool>
        <string name="Source"><![CDATA[-- [BoraVehicle] explicit entry/drive/exit lifecycle; no uploaded animation needed.
local Players=game:GetService('Players')
local Run=game:GetService('RunService')
local Tween=game:GetService('TweenService')
local Replicated=game:GetService('ReplicatedStorage')
local D=require(script.VehicleDynamics)
local Physics=require(script.VehiclePhysics)({Vector3=Vector3,CFrame=CFrame},D)
local folder=workspace:WaitForChild('BoraVehicles')
local remote=Replicated:WaitForChild('BoraVehicleControl')
local sessions,players={},{}
local zero={Throttle=0,Steer=0,Brake=true}
local function setState(s,state)
	s.State=state;s.Car:SetAttribute('Lifecycle',state)
	for _,p in s.Car:GetDescendants() do if p:IsA('ProximityPrompt') then p.Enabled=state=='Empty' end end
	if s.Player and s.Player.Parent then remote:FireClient(s.Player,'State',s.Car,state) end
end
local function door(s,name,open)
	local motor=s.Car.Mechanics:FindFirstChild(name)
	if not motor then return end
	local sign=if name:sub(-1)=='L' then -1 else 1
	Tween:Create(motor,TweenInfo.new(.45,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),
		{C0=motor:GetAttribute('ClosedC0')*CFrame.Angles(0,if open then math.rad(65)*sign else 0,0)}):Play()
	motor:SetAttribute('Open',open)
end
local function restore(s)
	local saved=s.Saved
	if not saved then return end
	for motor,c0 in saved.Joints do if motor.Parent then motor.C0=c0 end end
	for part,collide in saved.Collision do if part.Parent then part.CanCollide=collide end end
	if saved.Animate and saved.Animate.Parent then saved.Animate.Disabled=saved.AnimateDisabled end
	if s.Humanoid and s.Humanoid.Parent then
		s.Humanoid.WalkSpeed=saved.WalkSpeed;s.Humanoid.JumpPower=saved.JumpPower;s.Humanoid.JumpHeight=saved.JumpHeight;s.Humanoid.AutoRotate=saved.AutoRotate
	end
	if s.CharacterRoot and s.CharacterRoot.Parent then s.CharacterRoot.Anchored=saved.Anchored end
	for _,ik in s.IK or {} do if ik.Parent then ik:Destroy() end end
	s.IK={};s.Saved=nil
end
local function cleanup(s)
	s.Token+=1
	if s.Death then s.Death:Disconnect();s.Death=nil end
	if s.Car.DriverSeat:FindFirstChild('SeatWeld') then s.Car.DriverSeat.SeatWeld:Destroy() end
	if s.Humanoid and s.Humanoid.Parent then s.Humanoid.Sit=false end
	local player=s.Player
	restore(s)
	s.Car.DriverSeat.Disabled=true;s.Car.Chassis.Anchored=true
	s.Car.Chassis.AssemblyLinearVelocity=Vector3.zero;s.Car.Chassis.AssemblyAngularVelocity=Vector3.zero
	if s.Physics and s.Physics.reset then s.Physics:reset() end
	s.Car.Driver.Value=nil;s.Input=zero;s.ExitPending=false
	for _,name in {'DoorFL','DoorFR','DoorRL','DoorRR'} do door(s,name,false) end
	setState(s,'Empty')
	if player then players[player]=nil end
	s.Player,s.Humanoid,s.CharacterRoot=nil,nil,nil
end
local function saveCharacter(s,character,humanoid,hrp)
	s.Humanoid,s.CharacterRoot=humanoid,hrp
	local head=character:FindFirstChild('Head')
	s.AvatarEyeHeight=if head then hrp.CFrame:PointToObjectSpace(head.Position).Y+head.Size.Y*.12 else .57*D.Scale
	s.Saved={Joints={},Collision={},WalkSpeed=humanoid.WalkSpeed,JumpPower=humanoid.JumpPower,JumpHeight=humanoid.JumpHeight,AutoRotate=humanoid.AutoRotate,Anchored=hrp.Anchored}
	local saved=s.Saved;saved.Animate=character:FindFirstChild('Animate')
	if saved.Animate and saved.Animate:IsA('LocalScript') then saved.AnimateDisabled=saved.Animate.Disabled;saved.Animate.Disabled=true else saved.Animate=nil end
	local animator=humanoid:FindFirstChildOfClass('Animator')
	if animator then for _,track in animator:GetPlayingAnimationTracks() do track:Stop(.15) end end
	for _,item in character:GetDescendants() do
		if item:IsA('BasePart') then saved.Collision[item]=item.CanCollide;item.CanCollide=false
		elseif item:IsA('Motor6D') then saved.Joints[item]=item.C0 end
	end
	humanoid.WalkSpeed,humanoid.JumpPower,humanoid.JumpHeight,humanoid.AutoRotate=0,0,0,false
	hrp.Anchored=true
end
local function pose(s,lean,step)
	for motor,c0 in s.Saved.Joints do
		local lower=motor.Name:lower()
		if lower=='waist' or lower=='rootjoint' then motor.C0=c0*CFrame.Angles(math.rad(lean),0,math.rad(-lean*.2))
		elseif lower=='lefthip' or lower=='left hip' then motor.C0=c0*CFrame.Angles(math.rad(step),0,0)
		elseif lower=='righthip' or lower=='right hip' then motor.C0=c0*CFrame.Angles(math.rad(-step*.5),0,0) end
	end
end
local function travel(s,frame,duration,token)
	local tween=Tween:Create(s.CharacterRoot,TweenInfo.new(duration,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{CFrame=frame})
	tween:Play();tween.Completed:Wait()
	return s.Token==token and s.Player and s.Player.Parent and s.Humanoid.Health>0
end
local function hands(s)
	local character=s.Player.Character
	for _,side in {'Left','Right'} do
		local arm,hand=character:FindFirstChild(side..'UpperArm'),character:FindFirstChild(side..'Hand')
		if arm and hand then
			local ik=Instance.new('IKControl');ik.Name='BoraDriving'..side
			ik.Type=Enum.IKControlType.Position;ik.ChainRoot,ik.EndEffector=arm,hand
			ik.Target=s.Car.Components.Steering.Pivot[side..'Grip'];ik.SmoothTime=.1;ik.Weight=1;ik.Parent=s.Humanoid
			table.insert(s.IK,ik)
		else
			local torso=character:FindFirstChild('Torso');local shoulder=torso and torso:FindFirstChild(side..' Shoulder')
			if shoulder then shoulder.C0=s.Saved.Joints[shoulder]*CFrame.Angles(math.rad(-70),0,0) end
		end
	end
end
local function enter(s,player)
	local character=player.Character;local humanoid=character and character:FindFirstChildOfClass('Humanoid');local hrp=character and character:FindFirstChild('HumanoidRootPart')
	if not humanoid or not hrp or players[player] then return end
	if not D.canEnter(s.State,s.Car.Chassis.AssemblyLinearVelocity.Magnitude,humanoid.Health>0,(hrp.Position-s.Car.Chassis.DriverHandle.WorldPosition).Magnitude) then return end
	s.Player=player;players[player]=s;s.Token+=1;local token=s.Token
	s.Car.Chassis.Anchored=true;s.Car.Driver.Value=player
	s.IK={};saveCharacter(s,character,humanoid,hrp)
	s.Death=humanoid.Died:Connect(function() cleanup(s) end)
	for _,name in {'DoorFR','DoorRL','DoorRR'} do door(s,name,false) end
	setState(s,'Entering');door(s,'DoorFL',true)
	task.wait(.45);if s.Token~=token then return end
	local root=s.Car.Chassis
	local outside=root.CFrame*root.OutsideDriver.CFrame
	local facing=CFrame.lookAt(outside.Position,Vector3.new(root.Position.X,outside.Position.Y,outside.Position.Z))
	pose(s,8,22)
	if not travel(s,facing,.45,token) then return end
	pose(s,25,65)
	local seatMarker=root.SeatedRoot.CFrame
	local seatY=math.clamp(root.Eye.Position.Y-s.AvatarEyeHeight,-.25*D.Scale,.32*D.Scale)
	local seated=root.CFrame*CFrame.new(seatMarker.Position.X,seatY,seatMarker.Position.Z)*seatMarker.Rotation
	if not travel(s,seated*CFrame.new(-.7,-.2,0),.45,token) then return end
	pose(s,12,80)
	if not travel(s,seated,.38,token) then return end
	for motor,c0 in s.Saved.Joints do if motor.Parent then motor.C0=c0 end end
	hrp.Anchored=false
	s.Car.DriverSeat.Disabled=false;s.Car.DriverSeat:Sit(humanoid)
	local weld=s.Car.DriverSeat:WaitForChild('SeatWeld',2)
	if s.Token~=token then return end
	if not weld or s.Car.DriverSeat.Occupant~=humanoid then cleanup(s);return end
	weld.C0=s.Car.DriverSeat.CFrame:ToObjectSpace(seated);weld.C1=CFrame.new()
	if s.Saved.Animate then s.Saved.Animate.Disabled=s.Saved.AnimateDisabled end
	hands(s);door(s,'DoorFL',false);task.wait(.5)
	if s.Token~=token then return end
	s.Car.Chassis.Anchored=true
	s.Car.Chassis.AssemblyLinearVelocity=Vector3.zero;s.Car.Chassis.AssemblyAngularVelocity=Vector3.zero
	if s.Physics and s.Physics.reset then s.Physics:reset() end
	s.LastInput=os.clock();s.Input=zero;setState(s,'Driving')
end
local function exit(s)
	if s.State~='Driving' then return end
	setState(s,'Exiting');s.Token+=1;local token=s.Token
	local root=s.Car.Chassis;root.Anchored=true;root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
	for _,ik in s.IK do ik:Destroy() end;s.IK={}
	if s.Saved.Animate then s.Saved.Animate.Disabled=true end
	local weld=s.Car.DriverSeat:FindFirstChild('SeatWeld');if weld then weld:Destroy() end
	s.Car.DriverSeat.Disabled=true;s.Humanoid.Sit=false;s.CharacterRoot.Anchored=true
	door(s,'DoorFL',true);task.wait(.45);if s.Token~=token then return end
	pose(s,25,65)
	local outside=root.CFrame*root.OutsideDriver.CFrame
	if not travel(s,outside*CFrame.Angles(0,math.pi/2,0),.65,token) then return end
	local ray=workspace:Raycast(outside.Position+Vector3.yAxis*5,Vector3.new(0,-20,0),s.Ray)
	local height=s.Humanoid.HipHeight+s.CharacterRoot.Size.Y*.5
	local destination=if ray then Vector3.new(outside.Position.X,ray.Position.Y+height+.1,outside.Position.Z) else outside.Position
	pose(s,0,0)
	if not travel(s,CFrame.new(destination)*root.CFrame.Rotation,.25,token) then return end
	cleanup(s)
end
local function register(car)
	if car:GetAttribute('AssetKind')~='BoraVehicle' or sessions[car] then return end
	local ray=RaycastParams.new();ray.FilterType=Enum.RaycastFilterType.Exclude;ray.FilterDescendantsInstances={car};ray.RespectCanCollide=true
	local s={Car=car,State='Empty',Token=0,Input=zero,Ray=ray,LastInput=0,IK={}}
	s.Physics=Physics.new(car,workspace,ray);sessions[car]=s;car.Chassis.Anchored=true;car.DriverSeat.Disabled=true
	car.Destroying:Connect(function() if sessions[car] then cleanup(s);sessions[car]=nil end end)
	for _,name in {'DoorFL','DoorFR','DoorRL','DoorRR'} do
		local prompt=car.Components[name].Pivot.DoorPrompt.Interact
		prompt.Triggered:Connect(function(player)
			if name=='DoorFL' then task.spawn(function() local ok,err=pcall(enter,s,player);if not ok then warn('[BoraVehicle] entry',err);cleanup(s) end end)
			elseif s.State=='Empty' then
				local hrp=player.Character and player.Character:FindFirstChild('HumanoidRootPart')
				if hrp and (hrp.Position-prompt.Parent.WorldPosition).Magnitude<=12 then door(s,name,not car.Mechanics[name]:GetAttribute('Open')) end
			end
		end)
	end
	car.DriverSeat:GetPropertyChangedSignal('Occupant'):Connect(function()
		if s.State=='Driving' and car.DriverSeat.Occupant~=s.Humanoid then cleanup(s) end
	end)
	setState(s,'Empty')
end
remote.OnServerEvent:Connect(function(player,action,car,data)
	local s=players[player]
	if not s or s.Car~=car or s.State~='Driving' or car.DriverSeat.Occupant~=s.Humanoid then return end
	if action=='Input' then
		if os.clock()-s.LastInput<1/120 then return end
		local valid=D.input(data);if not valid then return end
		s.Input=valid;s.LastInput=os.clock()
	elseif action=='Exit' then s.ExitPending=true;remote:FireClient(player,'Notice',car,'정지 후 하차합니다.') end
end)
Run.Heartbeat:Connect(function(dt)
	for car,s in sessions do
		if not car.Parent then cleanup(s);sessions[car]=nil;continue end
		if s.State=='Driving' then
			if s.Player.Character then s.Ray.FilterDescendantsInstances={car,s.Player.Character} end
			local input=if os.clock()-s.LastInput>.4 or s.ExitPending then zero else s.Input
			s.Physics:step(dt,input)
			local speed=car:GetAttribute('SpeedKmh') or 0
			car.DashboardDisplay.SpeedDisplay.Speed.Text=tostring(speed)..(if car:GetAttribute('NumericInstrumentSpeed') then '' else '  km/h')
			local gear=car.DashboardDisplay.SpeedDisplay:FindFirstChild('Gear')
			if gear then gear.Text=if input.Brake then 'P' elseif input.Throttle<0 then 'R' else 'D' end
			local center=car:FindFirstChild('CenterDisplay')
			if center then center.Infotainment.Status.Text=if input.Brake then '브레이크' elseif input.Throttle<0 then '후진 중' else '주행 중' end
			if s.ExitPending and D.exitReady(math.abs(s.Physics.Speed or 0)) then
				task.spawn(function() local ok,err=pcall(exit,s);if not ok then warn('[BoraVehicle] exit',err);cleanup(s) end end)
			end
		end
	end
end)
Players.PlayerRemoving:Connect(function(player) local s=players[player];if s then cleanup(s) end end)
for _,car in folder:GetChildren() do register(car) end
folder.ChildAdded:Connect(register)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name"><![CDATA[VehicleDynamics]]></string>
          <string name="Source"><![CDATA[-- Pure controls/physics rules; all distances are Roblox studs.
local D={Scale=1/.28,Wheelbase=2.75/.28,Radius=.344/.28,RideHeight=.62/.28,
	ProbeUp=1/.28,ProbeDown=3/.28,MaxStep=.22/.28,MaxDrop=.35/.28,MaxSlope=math.tan(math.rad(26))}
local function finite(x) return type(x)=='number' and x==x and math.abs(x)<math.huge end
function D.input(data)
	if type(data)~='table' or not finite(data.Throttle) or not finite(data.Steer) or type(data.Brake)~='boolean' then return nil end
	if math.abs(data.Throttle)>1 or math.abs(data.Steer)>1 then return nil end
	return {Throttle=data.Throttle,Steer=data.Steer,Brake=data.Brake}
end
function D.control(speed,input)
	local mps=speed/D.Scale
	local angle=-input.Steer*math.rad(34)/(1+math.abs(mps)/16)
	local acceleration
	if input.Brake then acceleration=-math.clamp(mps*7,-16,16)
	elseif input.Throttle*mps<-.4 then acceleration=input.Throttle*12
	elseif input.Throttle~=0 then
		local limit=if input.Throttle>0 then 30 else 7
		acceleration=input.Throttle*7*math.clamp(1-math.abs(mps)/limit,0,1)
	else acceleration=-math.clamp(mps*1.2,-.8,.8) end
	return acceleration*D.Scale,angle
end
function D.canEnter(state,speed,healthy,distance)
	return state=='Empty' and math.abs(speed)<1 and healthy and distance<=12
end
function D.exitReady(speed) return math.abs(speed)<1.5 end
function D.wheelAngle(steer,x)
	if math.abs(steer)<.0001 then return 0 end
	local radius=D.Wheelbase/math.tan(steer)
	return math.atan(D.Wheelbase/(radius+x))
end
return D
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name"><![CDATA[VehiclePhysics]]></string>
          <string name="Source"><![CDATA[-- Stable ground-following arcade motion. Wheels are visual, not suspension.
return function(api,D)
	local V,C=api.Vector3,api.CFrame
	local P={}
	local codes={'FL','FR','RL','RR'}
	local function forward(yaw) return V.new(-math.sin(yaw),0,-math.cos(yaw)) end
	local function pose(position,yaw,up)
		local f=forward(yaw);f=(f-up*f:Dot(up)).Unit
		local right=f:Cross(up).Unit
		return C.fromMatrix(position,right,right:Cross(f).Unit,-f)
	end
	function P.new(car,world,rayParams)
		local root=car.Chassis
		local self={Car=car,Root=root,Speed=0,Spin=0,Steer=0}
		local wheels={}
		for _,code in codes do
			local joint=car.Mechanics['Wheel'..code]
			wheels[code]={Joint=joint,Closed=joint:GetAttribute('ClosedC0')}
		end
		function self:reset()
			self.Speed=0;self.Steer=0
			local f=root.CFrame.LookVector
			self.Yaw=math.atan2(-f.X,-f.Z)
			self.Ground=nil
		end
		self:reset()
		local function ground(position,yaw)
			local heading=C.new(position)*C.Angles(0,yaw,0)
			local points={};local centerHit=false;local normal=V.zero
			local function probe(offset,center)
				local p=heading:PointToWorldSpace(offset)
				local hit=world:Raycast(p+V.yAxis*D.ProbeUp,-V.yAxis*(D.ProbeUp+D.ProbeDown),rayParams)
				if not hit or hit.Normal.Y<.88 then return end
				local h=hit.Position
				table.insert(points,{X=h.X-position.X,Z=h.Z-position.Z,Y=h.Y})
				normal+=hit.Normal
				if center then centerHit=true end
			end
			probe(V.zero,true)
			for _,code in codes do
				local p=wheels[code].Closed.Position
				probe(V.new(p.X,0,p.Z),false)
			end
			if #points==0 or (not centerHit and #points<3) then return nil end
			local n=#points;local sx,sz,sy,sxx,szz,sxz,sxy,szy=0,0,0,0,0,0,0,0
			for _,p in points do
				sx+=p.X;sz+=p.Z;sy+=p.Y;sxx+=p.X*p.X;szz+=p.Z*p.Z;sxz+=p.X*p.Z;sxy+=p.X*p.Y;szy+=p.Z*p.Y
			end
			local xx,zz,xz=sxx-sx*sx/n,szz-sz*sz/n,sxz-sx*sz/n
			local xy,zy=sxy-sx*sy/n,szy-sz*sy/n
			local det=xx*zz-xz*xz
			local a,b
			if math.abs(det)>.00001 then a,b=(xy*zz-zy*xz)/det,(zy*xx-xy*xz)/det
			else normal=normal.Unit;a,b=-normal.X/normal.Y,-normal.Z/normal.Y end
			if a*a+b*b>D.MaxSlope*D.MaxSlope then return nil end
			local y=(sy-a*sx-b*sz)/n
			-- Keep the rigid wheel plane above small unevenness without springs.
			for _,p in points do y=math.max(y,p.Y-a*p.X-b*p.Z) end
			return {Y=y,Up=V.new(-a,1,-b).Unit}
		end
		function self:step(dt,input)
			dt=math.clamp(dt,0,.05);if dt==0 then return end
			root.Anchored=true
			root.AssemblyLinearVelocity=V.zero;root.AssemblyAngularVelocity=V.zero
			local old=root.CFrame.Position
			local current=ground(old,self.Yaw)
			if not current then self.Speed=0;car:SetAttribute('SpeedKmh',0);return end
			local acceleration,target=D.control(self.Speed,input)
			local before=self.Speed
			self.Speed+=acceleration*dt
			if (input.Brake or input.Throttle==0) and before*self.Speed<0 then self.Speed=0 end
			self.Steer+=(target-self.Steer)*(1-math.exp(-dt*12))
			local rate=self.Speed/D.Wheelbase*math.tan(self.Steer)
			local limit=math.rad(100)/(1+math.abs(self.Speed/D.Scale)/35)
			rate=math.clamp(rate,-limit,limit)
			local turn=rate*dt
			local movement=forward(self.Yaw+turn*.5)*self.Speed*dt
			local targetPosition=old+movement
			local nextGround=ground(targetPosition,self.Yaw+turn)
			local rise=if nextGround then nextGround.Y-current.Y else math.huge
			if not nextGround or rise>D.MaxStep+movement.Magnitude*D.MaxSlope or -rise>D.MaxDrop+movement.Magnitude*D.MaxSlope then
				movement=V.zero;turn=0;self.Speed=0;nextGround=current
			elseif movement.Magnitude>.00001 then
				local start=V.new(old.X,current.Y+D.RideHeight/current.Up.Y,old.Z)
				local cast=pose(start,self.Yaw+turn*.5,current.Up)*C.new(0,.22*D.Scale,0)
				local endY=nextGround.Y+D.RideHeight/nextGround.Up.Y
				local delta=V.new(movement.X,endY-start.Y,movement.Z)
				local hit=world:Blockcast(cast,V.new(1.9,1.2,4.65)*D.Scale,delta+delta.Unit*(.06*D.Scale),rayParams)
				if hit then
					local fraction=math.clamp((hit.Distance-.06*D.Scale)/delta.Magnitude,0,1)
					movement*=fraction;turn*=fraction;self.Speed=0
					nextGround=ground(old+movement,self.Yaw+turn) or current
				end
			end
			self.Yaw+=turn;self.Ground=nextGround
			local position=V.new(old.X+movement.X,nextGround.Y+D.RideHeight/nextGround.Up.Y,old.Z+movement.Z)
			root.CFrame=pose(position,self.Yaw,nextGround.Up)
			local distance=movement:Dot(forward(self.Yaw-turn*.5))
			self.Spin=(self.Spin-distance/D.Radius)%(math.pi*2)
			for _,code in codes do
				local w=wheels[code]
				local steer=if code:sub(1,1)=='F' then D.wheelAngle(self.Steer,w.Closed.Position.X) else 0
				w.Joint.C0=w.Closed*C.Angles(0,steer,0)*C.Angles(self.Spin,0,0)
			end
			car.Mechanics.Steering.C0=car.Mechanics.Steering:GetAttribute('ClosedC0')*C.fromAxisAngle(V.new(0,.5,.866025404),self.Steer*4)
			car:SetAttribute('SpeedKmh',math.floor(math.abs(self.Speed)/D.Scale*3.6+.5))
		end
		return self
	end
	return P
end
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="LocalScript" referent="7">
      <Properties>
        <string name="Name"><![CDATA[ClientTemplate]]></string>
        <bool name="Disabled">true</bool>
        <string name="Source"><![CDATA[-- [BoraVehicle] local controls, first-person cockpit and lifecycle HUD.
local Players=game:GetService('Players')
local CAS=game:GetService('ContextActionService')
local UIS=game:GetService('UserInputService')
local Run=game:GetService('RunService')
local remote=game:GetService('ReplicatedStorage'):WaitForChild('BoraVehicleControl')
local player=Players.LocalPlayer
local car,state,first=nil,'Empty',false
local pressed={};local previous;local yaw,pitch=0,0;local sendTime=0;local inputDirty=true
local transparent={}
local gui=Instance.new('ScreenGui');gui.Name='BoraVehicleHUD';gui.ResetOnSpawn=false;gui.Enabled=false;gui.Parent=player:WaitForChild('PlayerGui')
local panel=Instance.new('Frame');panel.Size=UDim2.fromOffset(390,88);panel.Position=UDim2.new(.5,-195,1,-115);panel.BackgroundColor3=Color3.fromRGB(23,29,35);panel.BackgroundTransparency=.15;panel.Parent=gui
local corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,10);corner.Parent=panel
local speed=Instance.new('TextLabel');speed.Size=UDim2.new(1,-20,0,37);speed.Position=UDim2.fromOffset(10,4);speed.BackgroundTransparency=1;speed.TextColor3=Color3.fromRGB(222,241,250);speed.TextSize=27;speed.Font=Enum.Font.GothamMedium;speed.Text='BORA Sedan';speed.Parent=panel
local hint=speed:Clone();hint.Name='Controls';hint.Size=UDim2.new(1,-20,0,39);hint.Position=UDim2.fromOffset(10,43);hint.TextSize=13;hint.TextWrapped=true;hint.Text='W/S 전진·후진   A/D 조향   Space 브레이크\nV 1·3인칭 전환   E 정차 후 하차';hint.Parent=panel
local notice=''
local function resetVisibility()
	for part,value in transparent do if part.Parent then part.LocalTransparencyModifier=value end end
	table.clear(transparent)
end
local function cockpitVisibility()
	local character=player.Character;if not character then return end
	for _,item in character:GetDescendants() do
		if item:IsA('BasePart') and (item.Name=='Head' or item:FindFirstAncestorOfClass('Accessory')) then
			if transparent[item]==nil then transparent[item]=item.LocalTransparencyModifier end
			item.LocalTransparencyModifier=1
		end
	end
end
local function cameraMode()
	local camera=workspace.CurrentCamera
	resetVisibility()
	if not camera or not previous then return end
	if first and state=='Driving' then
		camera.CameraType=Enum.CameraType.Scriptable;camera.FieldOfView=78
		UIS.MouseBehavior=Enum.MouseBehavior.LockCenter;UIS.MouseIconEnabled=false
	else
		camera.CameraType=Enum.CameraType.Custom;camera.CameraSubject=player.Character and player.Character:FindFirstChildOfClass('Humanoid')
		camera.FieldOfView=72;player.CameraMinZoomDistance=8;player.CameraMaxZoomDistance=35
		UIS.MouseBehavior=Enum.MouseBehavior.Default;UIS.MouseIconEnabled=true
	end
end
local function unbind()
	for _,key in {'Forward','Reverse','Left','Right','Brake','Exit','Camera'} do CAS:UnbindAction('BoraVehicle'..key) end
	pressed={};inputDirty=true;sendTime=0;resetVisibility()
	if previous then
		local camera=workspace.CurrentCamera
		player.CameraMinZoomDistance,player.CameraMaxZoomDistance=previous.Min,previous.Max
		player.CameraMode=previous.Mode
		if camera then camera.CameraType=Enum.CameraType.Custom;camera.CameraSubject=player.Character and player.Character:FindFirstChildOfClass('Humanoid');camera.FieldOfView=previous.FOV end
		UIS.MouseBehavior,UIS.MouseIconEnabled=previous.Mouse,previous.Cursor
		previous=nil
	end
	car,state,first=nil,'Empty',false;gui.Enabled=false
end
local function action(name,inputState)
	local key=name:gsub('^BoraVehicle','')
	local down=inputState==Enum.UserInputState.Begin
	if inputState==Enum.UserInputState.Begin or inputState==Enum.UserInputState.End or inputState==Enum.UserInputState.Cancel then
		if pressed[key]~=down then inputDirty=true end
		pressed[key]=down
	end
	if state=='Driving' and down then
		if key=='Exit' then remote:FireServer('Exit',car)
		elseif key=='Camera' then first=not first;yaw,pitch=0,0;cameraMode() end
	end
	return Enum.ContextActionResult.Sink
end
local function bind()
	for _,spec in {{'Forward',Enum.KeyCode.W,Enum.KeyCode.Up},{'Reverse',Enum.KeyCode.S,Enum.KeyCode.Down},
		{'Left',Enum.KeyCode.A,Enum.KeyCode.Left},{'Right',Enum.KeyCode.D,Enum.KeyCode.Right},
		{'Brake',Enum.KeyCode.Space},{'Exit',Enum.KeyCode.E},{'Camera',Enum.KeyCode.V}} do
		CAS:BindActionAtPriority('BoraVehicle'..spec[1],action,true,3000,table.unpack(spec,2))
		CAS:SetTitle('BoraVehicle'..spec[1],({Forward='가속',Reverse='후진',Left='◀',Right='▶',Brake='제동',Exit='하차',Camera='시점'})[spec[1]])
	end
	for _,spec in {{'Forward',.88,.55},{'Reverse',.88,.75},{'Left',.05,.70},{'Right',.20,.70},{'Brake',.72,.75},{'Exit',.05,.20},{'Camera',.20,.20}} do
		CAS:SetPosition('BoraVehicle'..spec[1],UDim2.fromScale(spec[2],spec[3]))
	end
end
remote.OnClientEvent:Connect(function(kind,vehicle,value)
	if kind=='Notice' and car==vehicle then notice=value;return end
	if kind~='State' then return end
	if value=='Empty' then if car==vehicle then unbind() end;return end
	if not previous then
		local camera=workspace.CurrentCamera
		previous={Min=player.CameraMinZoomDistance,Max=player.CameraMaxZoomDistance,Mode=player.CameraMode,FOV=camera.FieldOfView,Mouse=UIS.MouseBehavior,Cursor=UIS.MouseIconEnabled}
		player.CameraMode=Enum.CameraMode.Classic;bind()
	end
	car,state=vehicle,value;gui.Enabled=true;notice='';inputDirty=true;sendTime=.05
	if state~='Driving' then first=false;cameraMode() else cameraMode() end
end)
UIS.WindowFocusReleased:Connect(function() pressed={};inputDirty=true end)
player.CharacterRemoving:Connect(unbind)
Run:BindToRenderStep('BoraVehicleCamera',Enum.RenderPriority.Camera.Value+1,function(dt)
	if not car then return end
	if not car.Parent then unbind();return end
	if state=='Driving' then
		speed.Text=tostring(car:GetAttribute('SpeedKmh') or 0)..'  km/h'
		hint.Text=if notice~='' then notice else 'W/S 전진·후진   A/D 조향   Space 브레이크\nV 1·3인칭 전환   E 정차 후 하차'
		sendTime+=dt
		if sendTime>=1/60 and (inputDirty or sendTime>=.05) then
			sendTime=0;inputDirty=false
			remote:FireServer('Input',car,{Throttle=(if pressed.Forward then 1 else 0)-(if pressed.Reverse then 1 else 0),
				Steer=(if pressed.Right then 1 else 0)-(if pressed.Left then 1 else 0),Brake=pressed.Brake==true})
		end
		if first then
			local delta=UIS:GetMouseDelta();yaw=math.clamp(yaw-delta.X*.0025,-math.rad(100),math.rad(100));pitch=math.clamp(pitch-delta.Y*.0025,-math.rad(48),math.rad(38))
			workspace.CurrentCamera.CFrame=car.Chassis.CFrame*car.Chassis.Eye.CFrame*CFrame.Angles(0,yaw,0)*CFrame.Angles(pitch,0,0)
			cockpitVisibility()
		end
	else
		speed.Text=if state=='Entering' then '탑승 중' else '하차 중'
		hint.Text='문을 통과하는 동안 잠시 기다려 주세요.'
	end
end)
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>